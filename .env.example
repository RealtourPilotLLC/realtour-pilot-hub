# --- Database -------------------------------------------------------------
# Local dev today uses SQLite. For production (Vercel) this becomes a Postgres
# connection string from Neon, e.g.:
#   postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="file:./dev.db"

# --- Secrets --------------------------------------------------------------
# Master key used to encrypt integration API keys at rest. Generate a strong
# random value for production (e.g. `openssl rand -base64 32`). REQUIRED in prod.
APP_SECRET=""

# --- App URL --------------------------------------------------------------
# The public URL of the deployed app. Used for OAuth redirects + webhooks.
# e.g. https://realtour-pilot.vercel.app
NEXT_PUBLIC_APP_URL=""
