// RealTour Pilot — Operations Hub
// Data model for Milestone 1: the booked -> delivered project pipeline.
// Designed to grow: clients, deliverables, checklists, and activity timeline
// are all first-class so CRM, finance, and the upload portal slot in later.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  MANAGER
  SALES
  PHOTOGRAPHER
  EDITOR
  VA
}

// The booked -> delivered pipeline stages, in order.
enum ProjectStatus {
  BOOKED // order received, not yet scheduled
  SCHEDULED // shoot date set + photographer assigned
  SHOT // content captured / uploaded by photographer
  EDITING // assigned to an editor, in production
  REVIEW // internal QC / quality check
  DELIVERED // sent to client
  REVISION // delivered, then client requested changes — back in production
  ON_HOLD // blocked / waiting on client or info
  CANCELLED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// What was ordered for a shoot. Drives the photographer checklist later.
enum DeliverableType {
  PHOTOS
  VIDEO
  FLOORPLAN
  DRONE
  TWILIGHT
  MATTERPORT_3D
  VIRTUAL_STAGING
  SOCIAL_REEL
  ZILLOW_3D
  HEADSHOT
  OTHER
}

enum DeliverableStatus {
  PENDING // ordered, not yet produced
  UPLOADED // photographer uploaded raw content
  IN_PROGRESS // editor working on it
  DONE // finished
  FLAGGED // problem flagged, needs attention
}

// Kinds of entries on a project's activity timeline.
enum ActivityType {
  NOTE
  STATUS_CHANGE
  ASSIGNMENT
  SPECIAL_REQUEST
  FLAG
  FILE
  REMINDER
  SYSTEM
}

// ---------------------------------------------------------------------------
// Core models
// ---------------------------------------------------------------------------

model TeamMember {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  role              Role      @default(VA)
  phone             String?
  // Slack user id (U…) for direct pings; resolved from email on first use.
  slackId           String?
  avatarColor       String    @default("#6366f1") // for UI avatars
  // "Work-ons for your next shoot" — the AI-summarized THEMES of this person's
  // open capture feedback, cached so the page never waits on a model call.
  // focusSummaryKey fingerprints the notes it was built from; when the notes
  // change the key stops matching and the summary is rebuilt (on note write,
  // with the daily cron as the backstop).
  focusSummary      String? // JSON string array of bullets
  focusSummaryKey   String?
  focusSummaryAt    DateTime?
  active            Boolean   @default(true)
  // The Creative Manager sees EVERY creative's field alerts (forgotten uploads,
  // missing raws), not just their own — they are accountable for the whole
  // creative lane. A flag rather than a hard-coded name so a promotion or a
  // change of hands is one toggle, and so nothing silently keeps texting
  // someone who no longer holds the role.
  creativeManager   Boolean   @default(false)
  // Gets operational ALERT TEXTS (photos still not delivered, etc). An explicit
  // flag, not a role: the Role enum does not identify these people — Kyle is
  // MANAGER, and so is Kim, an editor in Manila who must never get ops pages.
  // Jordan is PHOTOGRAPHER because he shoots. Roles describe what someone does;
  // this describes who to wake up.
  opsAlerts         Boolean   @default(false)
  title             String? // free-form role label, e.g. "Lead Photographer"
  isServiceProvider Boolean   @default(false) // shoots/edits (from Aryeo)
  // Home base for the mileage radius (creatives are paid per mile beyond a radius).
  homeAddress       String?
  homeLat           Float?
  homeLng           Float?
  // Payout settings (manually set per creative; drive automatic payroll).
  // Shoot pay = max(eligible services invoice × payPercent, payFloor).
  payPercent        Float? // e.g. 0.35 = 35% of the eligible invoice
  payFloor          Float? // dollar minimum per shoot, e.g. 100
  mileageRate       Float     @default(0.65) // $/mile beyond the home radius
  homeRadiusMi      Int       @default(35) // free radius each way (daily free miles = ×2)
  // How this person is paid — photographers earn PER_SHOOT (the % engine above);
  // editors/ops are MONTHLY_FLAT (Kim $2,500/mo) or HOURLY (Remar, Kyle). These
  // costs were only ever in Jordan's bank account; PayrollEntry brings them in.
  payType           PayType   @default(PER_SHOOT)
  monthlyPay        Float? // MONTHLY_FLAT: the fixed monthly wage
  hourlyRate        Float? // HOURLY: $/hour
  // Aryeo linkage
  aryeoUserId       String?   @unique // /users id
  aryeoTeamMemberId String?   @unique // /company-team-members id (appointment assignee)
  createdAt         DateTime  @default(now())

  // Work assigned to this person
  shootsAsPhotographer Project[]          @relation("Photographer")
  projectsAsEditor     Project[]          @relation("Editor")
  projectsAsVa         Project[]          @relation("VA")
  authoredActivities   Activity[]
  mediaNotes           MediaNote[]
  assignedChecklist    ChecklistItem[]
  uploadedFiles        UploadedFile[]
  assignedAppointments Appointment[]
  smartTasks           SmartTask[]        @relation("TaskOwner")
  jobPayOverrides      JobPayOverride[]
  payoutAdjustments    PayoutAdjustment[]
  mileageDays          MileageDay[]
  payrollEntries       PayrollEntry[]
  bonusAwards          BonusAward[]
}

// How a team member is paid — see TeamMember.payType.
enum PayType {
  PER_SHOOT // photographers: % of eligible invoice (computePayroll owns these)
  MONTHLY_FLAT // fixed monthly wage (Kim)
  HOURLY // hours × rate (Remar, Kyle)
  NONE // not paid through payroll
}

// One recorded pay-out to a non-photographer (editor / ops) for one pay period —
// the bridge from "only in my bank account" into the Hub's P&L. `amount` is the
// single source of truth (dollars actually paid); hours/rate are just how it was
// derived for HOURLY. Photographers are NOT here (computePayroll handles them).
model PayrollEntry {
  id           String     @id @default(cuid())
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  teamMemberId String
  periodStart  String // yyyy-mm-dd bi-weekly period key (MONTHLY_FLAT: one per month)
  payDate      DateTime // when the money left the bank — drives the P&L month
  basis        String // "MONTHLY_FLAT" | "HOURLY"
  hours        Float? // HOURLY only
  rate         Float? // snapshot of hourlyRate/monthlyPay at entry time
  amount       Float // dollars actually paid — the source of truth
  note         String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([teamMemberId, periodStart]) // one entry per person per period
  @@index([payDate])
}

// A business (or personal) expense — the cost side of the P&L that lived nowhere
// before. `personal` flags draws / mixed-account spend so the P&L can separate
// business from personal (Jordan's stated need). Dollars, like price/payableInvoice.
model Expense {
  id        String   @id @default(cuid())
  spentAt   DateTime // when it was paid
  amount    Float // dollars
  category  String   @default("other") // software | subscriptions | gear | travel | fees | contractor | owner_draw | other
  vendor    String?
  note      String?
  personal  Boolean  @default(false) // true = personal/owner draw, excluded from business P&L
  recurring Boolean  @default(false) // marks a known monthly cost (rent, software) for the runway forecast
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([spentAt])
}

// A manual bank-balance reading so the runway/cash-position hero has a real cash
// number to anchor on (Aryeo/Stripe only know revenue, not what's in the account).
model CashSnapshot {
  id        String   @id @default(cuid())
  asOf      DateTime // date the balance was true
  balance   Float // dollars in the business checking account
  note      String?
  createdAt DateTime @default(now())

  @@index([asOf])
}

// A Stripe balance transaction — the authoritative money-in record: gross charged,
// Stripe's fee, and the net that actually lands in the bank. Synced read-only from
// the connected Stripe account; reconciled to a project best-effort.
model StripeTransaction {
  id           String   @id // Stripe's txn id (txn_…) — natural key, upsert on it
  type         String // charge | payment | refund | payout | adjustment | …
  gross        Float // dollars (amount, sign per direction)
  fee          Float // Stripe fee in dollars
  net          Float // gross − fee, dollars
  currency     String   @default("usd")
  createdAt    DateTime // Stripe `created`
  description  String?
  customerName String?
  destination  String? // Connect transfers: destination acct id (who got paid)
  projectId    String? // best-effort reconcile to an Aryeo project
  matchNote    String?
  syncedAt     DateTime @default(now())

  @@index([createdAt])
  @@index([type])
}

// A shoot appointment, synced from Aryeo /appointments (with assigned user).
model Appointment {
  id                   String      @id @default(cuid())
  aryeoId              String      @unique
  project              Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId            String
  startAt              DateTime?
  endAt                DateTime?
  durationMin          Int?
  status               String? // SCHEDULED | CANCELED | UNSCHEDULED
  title                String?
  description          String? // rich brief: customer, lockbox code, special instructions
  preferenceType       String?
  requiresConfirmation Boolean     @default(false)
  canCancel            Boolean     @default(false)
  canReschedule        Boolean     @default(false)
  rescheduledAt        DateTime?
  postponedAt          DateTime?
  previousStartAt      DateTime?
  rawJson              String? // full Aryeo payload for completeness
  // Photographer marked the shoot complete in the field (guided /shoot flow).
  // Distinct from the Aryeo `status`; drives the on-site experience + team feed.
  completedAt          DateTime?
  assignedTo           TeamMember? @relation(fields: [assignedToId], references: [id])
  assignedToId         String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @default(now()) @updatedAt

  @@index([projectId])
  @@index([startAt])
  @@index([assignedToId])
}

model Client {
  id          String   @id @default(cuid())
  name        String
  email       String? // priority email (most listings delivered to it)
  backupEmail String? // secondary email kept when duplicate contacts are merged
  phone       String?
  company     String? // brokerage / team name
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Free-form, smart-notes-ready fields (CRM milestone fills these out)
  editingPreferences String? // e.g. "Bright & airy, blue skies, no HDR halos"
  // THE customer note. There is exactly one, and Aryeo's customer
  // `internal_notes` is the system of record — this column mirrors it, and a
  // note typed in the hub is pushed straight back to Aryeo (see
  // writeAryeoCustomerNotes). The two fields below make the state of that
  // mirror visible instead of letting it drift in silence.
  generalNotes       String?
  notesSyncedAt      DateTime? // last time this mirror was confirmed against Aryeo
  notesSyncError     String? // why the last write-back failed (null = clean)

  // Agent Profile — the client's brand + working preferences (distinct from
  // editingPreferences, which is purely how to edit their media).
  clientPreferences String? // how they like to work: scheduling, comms, must-haves
  // CLIENT-OWNED portal fields (adversarial review, Aug 28): what the client
  // types on their own portal. Deliberately separate columns — the internal
  // editingPreferences/clientPreferences are ADMIN-authored notes the system
  // money-scrubs even from editors, and a public token must never read or
  // rewrite them.
  portalVideoStyle  String? // "how I like my videos", in the client's words
  portalPreferences String? // their own working-preference notes
  brandColors       String? // free text / hex list, e.g. "#0B1F3A, #C9A24B"
  brandAssetsPath   String? // Dropbox folder path holding their logo/fonts/brand kit

  // AI-built "working profile" — a creative-safe synthesis of who this client is
  // to work with (touch level, comms style, revision habits, brand taste, shoot
  // notes, dos/donts), drawn from comms, creatives' shoot debriefs, revision
  // history, and the manual notes above. Regenerable; powers the creatives portal.
  profileSummary   String? // one-paragraph narrative
  profileJson      String? // structured insights (JSON)
  profileUpdatedAt DateTime?

  // External system linkage
  aryeoCustomerId String? @unique
  licenseNumber   String?
  // The agent's headshot, mirrored from Aryeo's customer `avatar_url` (64 of
  // 366 customers carry one — the Zillow-synced ones). Aryeo owns it: the
  // nightly customer sync overwrites it, the hub never edits it. Shown wherever
  // the client is named (Jordan, Sep 2: "if the agent has a profile photo in
  // aryeo that should be shown here too as well as in other places the
  // clients are mentioned").
  avatarUrl       String?

  // Customer segmentation (computed from lifetime spend + completed-order count).
  // Mirrors the HubSpot segment model so the label is consistent everywhere a
  // client name is shown. Persisted so it's queryable + saved for later use.
  segment            String? // never_converted | one_timer | casual_repeat | regular | heavy | vip
  lifetimeSpendCents Int?
  transactionCount   Int       @default(0)
  segmentUpdatedAt   DateTime?

  // Monthly social-content subscription, synced from Aryeo customer custom
  // fields ("Social Client" = Yes/No, "Social Content Plan" = Starter/Accelerator/Pro).
  socialClient Boolean @default(false)
  socialPlan   String? // Starter | Accelerator | Pro

  // ---------------------------------------------------------------------------
  // Per-client notification switches (Jordan, Sep 2 2026: "I'd like to be able
  // to manually adjust notification preferences for each client"). Settings →
  // Automated texts is the GLOBAL master switch; these two are the per-client
  // exceptions to it. Both must be true for a text to auto-send.
  //
  // Two real boolean columns rather than one JSON prefs blob, because the text
  // sweeps decide in the QUERY (`client: { is: { autoDeliveryText: true } }`) —
  // a JSON column can't be filtered by Prisma without raw SQL, and every future
  // caller would have to remember to parse + default it. Default TRUE so all
  // 349 existing clients keep exactly today's behaviour.
  //
  // OFF NEVER MEANS SILENCE — it means A HUMAN SENDS IT. The sweep skips the
  // client and leaves the confirmation_text / delivery_text SmartTask OPEN, so
  // the reminder is still sitting on /tasks with its pre-drafted message and a
  // Send button. Nothing about the client's care is dropped; only the robot is.
  // ---------------------------------------------------------------------------
  autoConfirmationText Boolean @default(true) // shoot confirmation text, ~48h before the shoot
  autoDeliveryText     Boolean @default(true) // the post-delivery "how did we do?" feedback ask

  // ---------------------------------------------------------------------------
  // FIRST SIGHT (Jordan, Sep 7 2026: "if they were not in our system before and
  // are added as a contact … any new clients added to Aryeo should be added
  // here and start getting tracked").
  //
  // `createdAt` CANNOT answer "when did this person arrive": 349 of the 364
  // rows on file were minted by a bulk roster import, so their createdAt is the
  // day a sync ran, not the day the agent became our client. A welcome text
  // keyed off createdAt would greet a client of two years. So the Aryeo webhook
  // stamps firstSeenAt when IT creates the row, and it is deliberately left
  // NULL on everyone already here — every downstream feature (the dashboard
  // card, the welcome text) reads this column, so the back catalogue is out of
  // scope for them by construction rather than by a date cutoff someone has to
  // remember.
  // ---------------------------------------------------------------------------
  firstSeenAt   DateTime? // the moment the hub first learned this person exists
  firstSeenVia  String? // "aryeo-webhook" — how they reached us (shown on the card)
  welcomeTextAt DateTime? // the welcome text provably went out (see clientTextSweeps)

  // Aryeo customer-team membership. An agency team (e.g. "The Jamie Achberger
  // Group") groups the agent + their assistants/coordinators as separate
  // customer-users. We fold the assistants under the agent (`parentClientId`)
  // so their texts/emails route to the agent's projects — the orders live there.
  aryeoTeamId    String?
  aryeoTeamName  String?
  parentClientId String? // the agent/owner client this person assists (null = standalone)
  parent         Client?  @relation("ClientTeam", fields: [parentClientId], references: [id], onDelete: SetNull)
  teamMembers    Client[] @relation("ClientTeam")

  projects   Project[]
  smartTasks SmartTask[]
  contacts   Contact[]
  ownerTodos OwnerTodo[]

  @@index([email])
  @@index([parentClientId])
  // The home dashboard's new-client card and the welcome-text sweep both scan
  // "arrived in the last N days"; without this they table-scan all 364 clients
  // on every page render and every cron tick.
  @@index([firstSeenAt])
}

// A synced OpenPhone/HubSpot contact. Lets inbound comms from ANY known number
// (incl. a client's secondary line) resolve to the right client, and seeds the
// CRM. phones is a JSON string[] of raw numbers; matching is by last-10 digits.
model Contact {
  id          String   @id @default(cuid())
  openPhoneId String   @unique
  firstName   String?
  lastName    String?
  company     String?
  email       String?
  phones      String? // JSON: string[]
  source      String? // openphone-hubspot | openphone | ...
  externalId  String? // e.g. HubSpot id
  client      Client?  @relation(fields: [clientId], references: [id])
  clientId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId])
}

model Project {
  id       String        @id @default(cuid())
  title    String // usually the property address
  status   ProjectStatus @default(BOOKED)
  priority Priority      @default(NORMAL)

  // Content Creator Program: which monthly workspace this shoot belongs to.
  // Plain ref (no FK) — a month record can never cascade into live projects.
  contentMonthId String?

  // Property / order detail
  addressLine    String?
  city           String?
  state          String?
  zip            String?
  lat            Float? // from Aryeo listing.address.latitude — drives the map pins
  lng            Float? // from Aryeo listing.address.longitude
  squareFeet     Int?
  // The size BAND the client picked when ordering, verbatim off the order's
  // line items ("2,000-2,999 Sq. Ft."). 80% of orders carry one, against 7 of
  // 1,701 listings with an exact figure — so this is the real source for the
  // culling tier, and squareFeet above holds the TOP of it. Kept as text so a
  // screen can say what was actually ordered rather than implying we measured.
  squareFeetBand String?
  // Culling budget: target FINAL delivered photo count. Defaulted in code from
  // squareFeet (≥3500 → 80, else 50) unless the owner overrides on the project.
  // The status engine flags raw drops that blow past ~3.3× this (bracket ratio)
  // and Kyle's deliver card warns when the gallery ships over it.
  photoTarget    Int?
  // First live Aryeo listing image (thumbnail URL), captured by the status
  // sweep the moment photos land. Drives the My Shoots card thumbnail: Street
  // View of the address until the photos are in, then the real cover shot.
  coverImageUrl  String?
  packageName    String? // ordered package label
  price          Float? // order total
  // Eligible services invoice for creative pay = sum of non-canceled order items
  // EXCLUDING virtual/AI add-ons (virtual twilight/staging/declutter, AI renders).
  // Drives the percentage-of-invoice shoot pay. In dollars, like `price`.
  payableInvoice Float?

  // Scheduling
  orderedAt   DateTime? // real Aryeo order date (createdAt is import time)
  shootDate   DateTime?
  deliveryDue DateTime?
  deliveredAt DateTime?

  // ---- THE CLIENT ACTUALLY TOOK THE FILES (Sep 16 2026) --------------------
  // deliveredAt means "we sent it". These two mean "they picked it up", which
  // is a different and much better-evidenced fact: Aryeo fires a
  // LISTING_CONTENT_DOWNLOADED activity when an agent downloads content off a
  // delivered listing, and lib/aryeoDelivery records it here. Nothing sends or
  // decides anything on them yet — read the FEEDBACK ASK handover in that file
  // before wiring them to the client-text sweep.
  // NOT in statusEvidence: the status engine rewrites that blob whole on every
  // hourly pass, so a fact we are told once and can never re-derive would be
  // erased within the hour.
  //   contentDownloadedAt     — the FIRST download Aryeo has told us about
  //   contentDownloadedLastAt — the most recent one (an agent coming back for
  //                             the reel a week later is worth seeing)
  contentDownloadedAt     DateTime?
  contentDownloadedLastAt DateTime?

  // Billing (from Aryeo order)
  paymentStatus  String? // PAID | UNPAID | PARTIALLY_PAID | ...
  balanceAmount  Int? // cents still owed
  invoiceUrl     String?
  paymentUrl     String?
  // AR follow-up: when we last nudged the client about this unpaid job
  // (set by the /billing "Followed up" marker or sending a payment reminder).
  lastNudgedAt   DateTime?
  // Owner removed this from the AR (unpaid) list — a cancelled appointment we
  // never completed, or a test order. A FLAG, not a delete, so the Aryeo sync
  // can't resurrect it and the history stays auditable (Jordan, Sep 1).
  arRemovedAt    DateTime?
  arRemovedNote  String?
  // Owner/admin confirmed this was actually PAID (Aryeo's paid flag lags badly
  // for the QuickBooks rail, so the hub can't wait for it). Distinct from
  // arRemovedAt: removed = never really owed; paid = the money came in.
  // Both drop the row off AR; only this one means revenue was collected.
  paidMarkedAt   DateTime?
  paidMarkedNote String?

  // Relations / assignment
  client             Client      @relation(fields: [clientId], references: [id])
  clientId           String
  photographer       TeamMember? @relation("Photographer", fields: [photographerId], references: [id])
  photographerId     String?
  // Set when the owner assigns the photographer by hand — the Aryeo sync then
  // stops auto-filling photographerId from appointment assignees, so a manual
  // assignment isn't silently reverted an hour later.
  photographerManual Boolean     @default(false)
  editor             TeamMember? @relation("Editor", fields: [editorId], references: [id])
  editorId           String?
  // Set when the owner assigns the editor by hand (queue-row reassign). Mirrors
  // photographerManual: ensureEditorHandoff stops auto-filling editorId from
  // the routing rules, and mintEditTask routes the job to THIS editor when the
  // task first mints — so a pick made while the job is still upcoming (no task
  // yet) survives the shoot happening.
  editorManual       Boolean     @default(false)
  // WHO holds the edit when it is not one of our editors. An owner can hand a
  // job to the outside shop before any edit task exists (Jordan, Sep 7: "reassign
  // them to an external agency ... so our editors don't see jobs that are not
  // assigned to them"); editorId cannot say that because the agency has no
  // TeamMember. null = not with a vendor. Read with editorManual: a pin to NO
  // editor and NO vendor is a deliberate "nobody".
  editorVendorKey    String?
  va                 TeamMember? @relation("VA", fields: [vaId], references: [id])
  vaId               String?

  // External system linkage
  source         String    @default("MANUAL") // MANUAL | ARYEO | ...
  aryeoId        String? // legacy/general Aryeo ref
  aryeoOrderId   String?   @unique
  aryeoListingId String?
  // The order 404s in Aryeo (deleted / merged there) while the hub still holds
  // a live job. Set by the daily orphan sweep; every automation (status sweep,
  // client texts, chases) stands down while it is set, and ONE decision task
  // asks a human to cancel here or re-link. Cleared automatically if the order
  // reappears. Never auto-cancels (Sep 1 2026 audit: three live jobs pointed
  // at orders that no longer existed and nothing noticed).
  aryeoMissingAt DateTime?

  notes String?

  // Smart status engine: JSON evidence of how the status was computed
  // (expected vs present deliverables, Aryeo media counts, Dropbox files,
  // missing items, fulfillment mismatch) + when it was last cross-checked.
  statusEvidence  String?
  // Where this job's Dropbox listing folder actually IS. Written by the folder
  // engine (src/lib/dropboxFolders.ts) when it creates or moves the folder —
  // the Zap could never handle reschedules because nothing remembered the old
  // path; this is that memory. Null = engine hasn't touched it (pre-Aug-2026
  // jobs, or Dropbox disconnected).
  dropboxFolder   String?
  statusCheckedAt DateTime?

  // Comms cross-check: set when a client communication (text/call/email) on a
  // delivered job is detected as a change/revision request. Drives REVISION
  // status until resolved.
  revisionRequestedAt DateTime?
  revisionNote        String?

  // Photographer's brief to the editor, captured at upload time.
  editorBrief  String?
  // Shoot debrief (upload portal rebuild, Aug 31 2026) — structured fields the
  // photographer fills before the job counts as done. All feed the editor brief.
  // Monthly-content plans (Starter/Accelerator/Pro) owe a BATCH of videos, so
  // the photographer reports how many they actually filmed on the wrap-up —
  // the editor needs the count to know how many cuts to produce (Jordan, Sep 1).
  videosFilmed Int?

  // ---- OFFICE OVERRIDES (Jordan, Sep 13: "I want to be able to change the
  // status, amount of deliverables, the due date and all other information
  // for the edits in the editing room. I want to be able to override
  // anything."). Hub-owned: no sweep, sync or reconciler ever writes these;
  // every reader prefers them over the computed value. null = no override.
  // statusPinnedAt: while set, no ENGINE may write Project.status (the hourly
  // status/folder sweeps, the task reconciler, the Aryeo sync); a human status
  // write (queue pill, pipeline board, the override dialog) clears or renews it.
  statusPinnedAt     DateTime?
  // The delivery due the office set — wins over the turnaround engine on the
  // queue row, the edit card, the tracker, the delivery board and the QC card.
  dueOverrideAt      DateTime?
  // How many videos this job owes — wins over videosFilmed and the order's
  // deliverable quantity everywhere (queue, cut slots, monthly quota).
  videosOwedOverride Int?
  tierOverride       String? // standard | premium | branding
  typeDetailOverride String? // the row's "video type" text
  priorityOverride   String? // LOW | NORMAL | HIGH | URGENT — pins the edit card's priority
  overrideBy         String? // who last saved an override
  overrideAt         DateTime?
  overrideNote       String? // their reason, shown on the row and the timeline
  cullingConfirmedAt DateTime? // ticked "culled to the standard, extras in Backup"
  debriefSubmittedAt DateTime? // the photographer SUBMITTED the upload page (finalizeUpload) — distinct from uploadedAt, which the Dropbox sweep can auto-stamp; gates My Pay visibility for shoots from Sep 2 2026
  shotOrderNotes     String? // "Shot front to back." or the actual order + why (organizing unseen photos burns office time)
  removalNotes       String? // pets/cans/vehicles/clutter the editor must remove
  videoInstructions  String? // REQUIRED on video jobs: flow + vision for the editor
  scriptConfirmedAt  DateTime? // photographer confirmed the shoot script (as-is or edited)
  scriptConfirmNote  String? // "as written" | "edited on site" + what changed
  // Edit instructions for THIS job, set by owner/admin on /edit/<id> and shown
  // read-only to the editor (mirrors the Luma order form Jordan likes):
  // JSON { musicType, colorProfile, desiredLength, instructions }
  editSpec           String?
  // Per-job photo-editing inputs (AutoHDR $0.50/finished photo). Counted from
  // the Dropbox 01-RAW-Photos folder: drone shots are single JPGs (DJI_*),
  // everything else is 5-bracket sets. finished = (raw−drone)/5 + drone.
  rawPhotoCount      Int?
  dronePhotoCount    Int?
  photoCountedAt     DateTime?
  // When the photographer finished the guided upload.
  uploadedAt         DateTime?
  // Relative path to the generated editor-brief PDF, if any.
  editorPdfPath      String?

  // Frame.io V4 review project (editors upload finals + we review there).
  frameioProjectId String?
  frameioViewUrl   String?

  // "Reel recipe" — the creative plan for a video/reel job (Agent-on-Camera).
  // Captured pre-shoot, carried to the editor. reelScriptUrl bridges to Jordan's
  // external script generator/tracker; the reelScripting* fields below are the
  // LIVE link to it (Script Studio API v1).
  reelHook            String?
  reelScript          String?
  reelSong            String?
  reelShotList        String?
  reelScriptUrl       String?
  reelRecipeUpdatedAt DateTime?

  // Live link to the external Script Studio (scripting platform API v1). external_id
  // there == this project's id (dedupe key). Populated by create + webhook sync.
  scriptingId       String? // the Script Studio project id
  scriptingStatus   String? // last-known Studio status (awaiting_intake … done)
  scriptingUrl      String? // best link to open there (agent intake or review)
  scriptingSyncedAt DateTime?

  deliverables      Deliverable[]
  orderItems        OrderItem[] // the real Aryeo line items (commercial truth)
  checklist         ChecklistItem[]
  activities        Activity[]
  uploads           UploadedFile[]
  appointments      Appointment[]
  smartTasks        SmartTask[]
  feedback          Feedback[]
  messages          ProjectMessage[]
  payOverrides      JobPayOverride[]
  imageFlags        ImageFlag[]
  mediaNotes        MediaNote[]
  mediaVerdicts     MediaVerdict[]
  qcRecords         QcRecord[]
  reviewSubmissions ReviewSubmission[]
  topazJobs         TopazJob[]
  revisionBriefs    RevisionBrief[]

  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  ownerTodos          OwnerTodo[]
  // ---- RTP-06 (Sep 16 audit): "we could not look" must be distinguishable
  // from "we looked and saw nothing". statusCheckedAt is stamped even when the
  // evidence read fails wholesale, so two readers already treat a failure as
  // freshness. attempted/succeeded split; a stale zero never proves absence.
  evidenceAttemptedAt DateTime?
  evidenceSucceededAt DateTime?
  evidenceError       String?

  @@index([status])
  @@index([clientId])
  @@index([photographerId])
  @@index([editorId])
  @@index([shootDate])
  @@index([deliveredAt])
}

model Deliverable {
  id                   String            @id @default(cuid())
  project              Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId            String
  type                 DeliverableType
  label                String? // optional override label
  // PRODUCT IDENTITY (Sep 2 2026). `type` is a CATEGORY — mapping an Aryeo
  // line through Settings → Products used to keep only that and a generic
  // label ("Social Reel"), so "Standard Reel with Agent Intro" and "Photography
  // and Standard Reel" became the same row and every downstream surface (editor
  // brief, cuts to deliver, upload-portal brief shape, Style Guide reference)
  // read the wrong thing (626 Greycliffe — Jordan: "That should be shown as
  // video type"). These two columns keep the identity the category discards:
  //   productTitle — the Aryeo order-item name this row came from, VERBATIM
  //     (one row per type is the invariant, so a merged row keeps the title of
  //     the item whose label won — the MAIN product over an add-on).
  //   videoStyle — the Style Guide type, resolved at sync for VIDEO /
  //     SOCIAL_REEL rows (drone video included), one of the VIDEO_STYLE keys in
  //     integrations/aryeo.ts: standard_reel · standard_reel_agent_intro ·
  //     standard_cinematic · personal_branding · premium_social_reel ·
  //     premium_cinematic. Null on every non-video row.
  productTitle         String?
  videoStyle           String?
  quantity             Int               @default(1)
  status               DeliverableStatus @default(PENDING)
  notes                String?
  // Photographer ticked this off on-site (guided /shoot capture checklist).
  // Lets the team see what was confirmed captured before files are uploaded.
  capturedAt           DateTime?
  // Photographer ticked this off as uploaded to Dropbox (/upload checklist).
  // They upload to Dropbox directly — this is the accountability signal that the
  // raw files for this item are in, so editors aren't chasing ETAs.
  uploadedAt           DateTime?
  // Photographer marked this item NOT completed on the wrap-up step (couldn't
  // shoot / couldn't upload) with the reason the Admin reads — surfaces on the
  // /ops QC card + project timeline. Cleared if the item is later marked
  // uploaded (Jordan, Sep 1 2026).
  notCompletedReason   String?
  notCompletedAt       DateTime?
  // The Aryeo order no longer carries an item for this deliverable (removed —
  // not canceled — on their side). RETIRED, never deleted: status/uploads/
  // capturedAt stay as evidence of work that happened. Every "what is owed"
  // consumer filters removedFromOrderAt: null (OWED_DELIVERABLE_WHERE). Cleared
  // if the item reappears on the order. (Sep 1 2026: 632 Greenridge chased a
  // video for a week after the item was pulled from the order.)
  removedFromOrderAt   DateTime?
  removedFromOrderNote String?
  // Hub-created row (editor's manual queue-add, owner tooling) — never touched
  // by the order reconcile, which only knows about Aryeo line items.
  manual               Boolean           @default(false)
  createdAt            DateTime          @default(now())

  uploads           UploadedFile[]
  reviewSubmissions ReviewSubmission[]
  // ---- Sep 16 (Kyle call, item 9): "not required on this job". Hub-owned —
  // the Aryeo reconcile never clears it (unlike removedFromOrderAt, which a
  // package-implied type un-retires). Every "owed" reader honours it.
  waivedAt          DateTime?
  waivedBy          String?
  waivedNote        String?

  @@index([projectId])
}

// A file uploaded through the photographer portal. The actual bytes live in
// local storage today; this maps cleanly onto a Dropbox file later.
model UploadedFile {
  id            String       @id @default(cuid())
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId     String
  deliverable   Deliverable? @relation(fields: [deliverableId], references: [id], onDelete: SetNull)
  deliverableId String?
  originalName  String
  storedPath    String // relative path within the storage root
  size          Int
  mimeType      String
  uploadedBy    TeamMember?  @relation(fields: [uploadedById], references: [id])
  uploadedById  String?
  createdAt     DateTime     @default(now())

  @@index([projectId])
}

model ChecklistItem {
  id         String      @id @default(cuid())
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String
  label      String
  done       Boolean     @default(false)
  forRole    Role? // which team role this is for
  assignee   TeamMember? @relation(fields: [assigneeId], references: [id])
  assigneeId String?
  dueAt      DateTime?
  sortOrder  Int         @default(0)
  createdAt  DateTime    @default(now())

  @@index([projectId])
}

model Activity {
  id        String       @id @default(cuid())
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  type      ActivityType @default(NOTE)
  body      String
  author    TeamMember?  @relation(fields: [authorId], references: [id])
  authorId  String?
  createdAt DateTime     @default(now())

  @@index([projectId])
}

// ---------------------------------------------------------------------------
// Knowledge: resources + SOPs (the "Resources" tab Kyle uses)
// ---------------------------------------------------------------------------

model Resource {
  id          String   @id @default(cuid())
  title       String
  url         String
  category    String // e.g. "Tools", "Booking & Calls", "Brand Assets"
  description String?
  icon        String? // lucide icon name
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([category])
}

model Sop {
  id        String   @id @default(cuid())
  title     String
  category  String // e.g. "Shooting", "Editing", "Delivery", "Sales"
  summary   String? // one-liner
  content   String // markdown-ish body
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([category])
}

// Full training transcripts for the browsable /training course library (910
// Academy). Kept separate from KnowledgeItem: these are long-form (some 200k+
// chars) for READING, while the Hub searches concise/chunked KnowledgeItems.
model TrainingLesson {
  id         String    @id @default(cuid())
  volumeNo   Int       @default(1) // 1 = Agent on Camera, 2 = All Courses
  volume     String // display name of the volume
  courseNo   Int       @default(0) // order of the course within the volume
  course     String // course / module grouping within the volume
  orderNo    Int // lesson order within the volume
  title      String
  body       String // full transcript (verbatim)
  summaryMd  String? // AI-formatted, summarized markdown (headings + bullets) — the default reading view
  videoUrl   String? // 910 Academy Vimeo watch URL (embedded in the lesson view)
  source     String    @default("910-academy")
  // Public share: an unguessable token → the lesson is viewable at /learn/<token>
  // WITHOUT a login (video + summary only, never the verbatim transcript).
  // Owner mints it on demand; clearing the token revokes the link.
  shareToken String?   @unique
  sharedAt   DateTime?
  createdAt  DateTime  @default(now())

  @@index([volumeNo, orderNo])
}

// Listener-first operations: a tracked, auto-generated task in Kyle's queue.
// status/taskType/priority are strings (the spec has many values) to stay flexible.
// One row per in-app page visit — the OWNER-ONLY usage trail (People →
// Activity tab). Written by /api/activity from the SESSION identity (never the
// client's claims); "view as" previews are skipped so they can't pollute the
// person being previewed. Pruned to ~90 days on read.
model UsageEvent {
  id        String   @id @default(cuid())
  userId    String // AppUser.id (denormalized — survives user edits)
  email     String
  name      String?
  role      String
  path      String // in-app pathname, e.g. "/shoot/abc123"
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

model SmartTask {
  id               String    @id @default(cuid())
  status           String    @default("OPEN") // OPEN | IN_PROGRESS | WAITING_* | BLOCKED | COMPLETED | CANCELLED
  taskType         String // appointment_prep | media_qa | delivery | client_reply | reschedule_confirmation | ...
  priority         String    @default("MEDIUM") // URGENT | HIGH | MEDIUM | LOW
  title            String
  summary          String? // human "what happened + what's needed" — shown in the card's expandable section
  description      String?
  reasonCreated    String?
  // WHO flagged this and when — set only when a person deliberately flags work
  // for somebody else (Jordan, Sep 7: "when I flag something for someone it
  // should pop up on their home screen at the top"). Distinct from `source`,
  // which says which SYSTEM minted the row; these two say a human sent it, and
  // they are what the "Flagged by <name>" banner reads. Cleared when the task
  // is closed, like any other work.
  flaggedBy        String?
  flaggedAt        DateTime?
  checklist        String? // JSON: string[] — retained for the consolidated QC task's auto-close (no longer a UI checklist)
  source           String    @default("system") // aryeo | openphone | gmail | slack | manual | system
  sourceDetail     String? // url / message id / note
  assignedKey      String? // editor this work is delegated to (see src/lib/editors.ts): kim|remar|luma|autohdr|cubicasa|kyle
  // A HUMAN picked assignedKey (owner reassign / "Add a job to the queue"). The
  // automatic engines respect it: mintEditTask's refresh keeps the editor,
  // ensureEditorHandoff skips its editorId/raw-chase overrides, and the
  // evidence-based auto-close leaves the task alone (stale "video delivered"
  // evidence must not kill work a human just reopened on purpose).
  assignedManually Boolean   @default(false)
  dueAt            DateTime?
  completedAt      DateTime?

  // Links
  owner           TeamMember? @relation("TaskOwner", fields: [ownerId], references: [id])
  ownerId         String?
  project         Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId       String?
  client          Client?     @relation(fields: [clientId], references: [id])
  clientId        String?
  // The actual human who wrote in (e.g. an assistant like Olivia), shown as the
  // person on the task when it differs from the account client the message folds
  // to (the agent whose orders it lands on). Null when the sender IS the client.
  contactName     String?
  propertyAddress String?
  deliverableType String?

  // Idempotency for auto-generated/listener tasks.
  dedupeKey String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([projectId])
  @@index([clientId])
  @@index([dueAt])
  @@index([completedAt])
}

// Client feedback collected after delivery (via the post-delivery text's form
// link, or logged from a text/email). Pipes onto the project, alerts Kyle +
// the photographer, and feeds creative KPIs / problem-pattern analytics.
model Feedback {
  id                 String    @id @default(cuid())
  project            Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId          String
  // The one overall score everything already reads (avg-rating tile, sentiment,
  // the photographer scorecards). From the public form it is what the client
  // tapped on "Overall", and when they skipped that row it is the rounded mean
  // of the two per-question ratings below — a client who rates their
  // photographer 1/5 and skips "Overall" must still trip the NEGATIVE path.
  rating             Int? // 1-5 overall
  sentiment          String? // POSITIVE | NEUTRAL | NEGATIVE
  category           String? // quality | communication | turnaround | other
  // The human-readable transcript of the whole response — every surface in the
  // hub renders this (the /quality row, the URGENT task, the bell), so the
  // three answers below are also composed into it. The columns are the
  // queryable copy; this is the copy a person reads.
  body               String
  // --- The three questions the public form asks (Jordan, Sep 2 2026) --------
  // "I want to know how their experience was with the assigned photographer.
  // What they would like to see done differently, and ask about the quality of
  // their content. Then I want to be able to view that data."
  //
  // One column per answer so each is scoreable on its own: photographerRating
  // is the number that belongs to the person in `photographerId` (their KPI),
  // contentRating is the number that belongs to the WORK. Every one of them is
  // nullable on purpose — the form submits with a single answer filled in, and
  // a half-answered response is worth more than a bounced one.
  photographerRating Int? // 1-5 — experience with the photographer who shot it
  photographerNote   String? // their words about that person
  improveNote        String? // "what would you like to see done differently?"
  contentRating      Int? // 1-5 — quality of the content we delivered
  contentNote        String? // their words about the content
  authorName         String?
  source             String    @default("form") // form | text | email
  photographerId     String? // who shot it, for creative scorecards
  // WHOSE PROBLEM IS IT (Jordan, Sep 7 2026: "reels turned around quicker and
  // less spelling errors ... should not affect the photographer. This is an
  // editing and operations issue not a photographer issue. I want to make sure
  // photographers aren't getting dinged for that").
  //
  //   ONSITE     — what happened at the property: the shoot itself, conduct,
  //                punctuality, what was or wasn't captured. The photographer's.
  //   OPERATIONS — everything after the shutter: editing, spelling, turnaround,
  //                delivery, scheduling, billing. Not the photographer's.
  //   MIXED      — genuinely both; counts for the photographer on the ONSITE
  //                half only, and the note says which half.
  //   null       — not classified yet (pre-Sep-7 rows and anything the
  //                classifier could not read).
  // The photographer's KPI counts ONSITE and MIXED only — see src/lib/kpi.ts.
  attribution        String?
  /**
   * Why it was classified that way, in one line — shown beside the chip so an
   * owner can see the reasoning before overriding it.
   */
  attributionWhy     String?
  /**
   * Set when a human confirmed or changed the classification: an owner's call
   * is never re-decided by the classifier on a later pass.
   */
  attributionBy      String?
  // --- The reply we sent the agent (Jordan, Sep 7) -------------------------
  repliedAt          DateTime?
  replyBody          String?
  replyBy            String?
  resolved           Boolean   @default(false)
  createdAt          DateTime  @default(now())
  // ---- Sep 16 (Kyle call, item 10): correct an automated read without losing
  // the original. sentimentAuto = what the classifier decided (never rewritten);
  // a human override records who/when/why; dismissed = "not feedback" (hidden
  // from every count, row kept); sourceRef = CommLog id for comms-filed rows.
  sentimentAuto      String?
  sentimentBy        String?
  sentimentAt        DateTime?
  sentimentNote      String?
  dismissedAt        DateTime?
  dismissedBy        String?
  dismissReason      String?
  sourceRef          String?

  @@index([projectId])
  @@index([photographerId])
  @@index([sentiment])
}

// A lightweight team chat thread on a project — Kyle ↔ editors ↔ photographers
// coordinating on a specific job (separate from the Aryeo/system Activity feed).
// Author is a free String (selected from the team in the UI) so editors who
// aren't full app users can still be attributed.
model ProjectMessage {
  id         String           @id @default(cuid())
  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String
  authorId   String? // TeamMember id, if picked from the roster
  authorName String? // display name
  body       String
  mentions   String? // JSON array of tagged TeamMember ids
  // Threaded reply: the message this one is replying to (same thread).
  replyToId  String?
  replyTo    ProjectMessage?  @relation("MsgReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies    ProjectMessage[] @relation("MsgReplies")
  createdAt  DateTime         @default(now())

  @@index([projectId])
}

// A client's change request, turned into a work order. The raw ask (a 20-minute
// phone call, a rambling email) is kept WHOLE in `originalText`; the AI pass
// splits it into discrete, area-tagged items the editor can actually work
// through, plus what to leave alone, what the client is sending, and what to
// confirm before starting. One row per incoming ask, so a second call adds a
// round instead of overwriting the first (Jordan, Aug 27: Marcee's call reached
// the editor as a truncated wall of one-sided transcript).
model RevisionBrief {
  id            String    @id @default(cuid())
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId     String
  taskId        String? // the revision SmartTask this ask belongs to
  source        String // openphone | gmail | review_room | manual | …
  sourceDetail  String? // thread ref, so the full conversation stays reachable
  originalText  String // the client's words, UNCLIPPED — the record of truth
  twoSided      Boolean   @default(false) // true when originalText is a full dialogue
  headline      String?
  itemsJson     String? // { items, keep, references, questions }
  doneJson      String? // ids of items the editor has ticked off
  analyzedAt    DateTime?
  analysisError String?
  createdAt     DateTime  @default(now())

  @@index([projectId])
  @@index([taskId])
}

// Per-person read watermark for a project's message thread — powers the
// unread dots + badge in the message center (/editing/messages). userKey is
// the viewer's AppUser id; upserted when they open the thread.
model ThreadRead {
  id        String    @id @default(cuid())
  userKey   String
  projectId String
  seenAt    DateTime  @default(now())
  // Sep 16 (Kyle call): "Close conversation" hides a job thread from this
  // viewer's active list until a new message reopens it (postProjectMessage
  // clears it for every viewer of the project).
  closedAt  DateTime?

  @@unique([userKey, projectId])
  @@index([userKey])
}

// Service catalogue synced from Aryeo /products.
// The LINE ITEMS of an Aryeo order, exactly as the client bought them.
//
// Deliverable is our internal production view: itemToDeliverables() maps a
// product down to the media types we have to capture ("Standard Reel with Agent
// Intro" becomes a generic SOCIAL_REEL), and dedupeParsedDeliverables() then
// collapses to one row per type. That is right for QC and delivery, but it
// destroys the product mix — you can't tell a $350 Standard Video Highlight Reel
// from a $2,000 Premium Social Media Reel, or see a GOLD BUNDLE at all.
//
// This table keeps the commercial truth alongside it: what was ordered, how
// many, and for how much. Purely additive — nothing reads it for production.
model OrderItem {
  id         String   @id @default(cuid())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String
  aryeoId    String? // Aryeo's order-item id, when it gives us one
  title      String // the real product name, verbatim
  quantity   Int      @default(1)
  amount     Float    @default(0) // line total in DOLLARS (Aryeo sends cents)
  isCanceled Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([projectId])
  @@index([title])
}

model Product {
  id               String    @id @default(cuid())
  aryeoId          String    @unique
  title            String
  type             String? // MAIN | ADDON
  category         String?
  active           Boolean   @default(true)
  isTwilight       Boolean   @default(false)
  // Aryeo's native is_serviceable flag — the DEFAULT for the per-part
  // shoot/add-on toggles until a human maps the product.
  aryeoServiceable Boolean?
  description      String?
  // ---- Manual mapping (settings → Products) — the AUTHORITATIVE category
  // assignment, set by a human. When present it overrides every regex/AI
  // parser at sync time (Aug 24: phantom floor plans / Faye's ghost video).
  mediaTypes       String? // JSON DeliverableType[] this product actually produces ([] = none, e.g. a fee)
  videoTier        String? // standard | premium | personal_branding (when a video/reel type is included)
  // The Style Guide type this product's video is cut as (Sep 2 2026) — one of
  // the VIDEO_STYLE keys in integrations/aryeo.ts (standard_reel ·
  // standard_reel_agent_intro · standard_cinematic · personal_branding ·
  // premium_social_reel · premium_cinematic). Set by a human on
  // Settings → Products; when null the sync derives it from videoTier + the
  // product name (an "Agent on Camera" add-on on the same order upgrades a
  // standard reel to the agent-intro type).
  videoStyle       String?
  serviceKind      String? // service (done at the shoot) | addon (post-shoot work, e.g. photo editing)
  // Per-PART kinds: the subset of mediaTypes that are post-shoot add-on work
  // (a bundle's photos are shoot work while its virtual staging is editing).
  addonTypes       String? // JSON DeliverableType[]
  // How many VIDEOS one order of this product produces (Accelerator = 4, a
  // two-reel bundle = 2). Applies to VIDEO / SOCIAL_REEL / DRONE_VIDEO rows.
  videoQuantity    Int?
  mappedAt         DateTime?
  mappedBy         String? // email of who set it
  minPrice         Int? // cents (lowest variant)
  maxPrice         Int? // cents (highest variant)
  variants         String? // JSON: [{title, price_amount, duration}]
  tags             String? // JSON: string[] of tag names
  updatedAt        DateTime  @updatedAt
  createdAt        DateTime  @default(now())

  @@index([type])
}

// ---------------------------------------------------------------------------
// Integrations: external service connections + webhook audit log
// ---------------------------------------------------------------------------

// One row per connected external service (aryeo, stripe, gmail, …).
// Secrets are stored encrypted-at-rest (see lib/integrations/crypto.ts) and are
// never sent to the client.
model Connection {
  id              String    @id @default(cuid())
  provider        String    @unique // "aryeo", "stripe", "dropbox", …
  status          String    @default("DISCONNECTED") // DISCONNECTED | CONNECTED | ERROR
  secretEncrypted String? // encrypted API key / token blob
  accountLabel    String? // human label, e.g. the connected account name
  metadata        String? // JSON blob for provider-specific config
  lastSyncedAt    DateTime?
  lastError       String?
  webhookSecret   String? // for verifying inbound webhooks
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Per-job pay override for a creative on one project (covers the manual cases:
// "$75 flat, no mileage", remove a canceled job, flat partial-completion amount).
model JobPayOverride {
  id              String     @id @default(cuid())
  project         Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId       String
  teamMember      TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  teamMemberId    String
  invoiceOverride Float? // correct the eligible invoice the % is applied to
  flatAmount      Float? // override shoot pay to this flat dollar amount (wins over %)
  noMileage       Boolean    @default(false) // exclude this job from the day's mileage split
  excluded        Boolean    @default(false) // drop this job from payout entirely
  manualAdd       Boolean    @default(false) // pay this member for this job even if they aren't the appt shooter (manually added)
  note            String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @default(now()) @updatedAt

  @@unique([projectId, teamMemberId])
  @@index([teamMemberId])
}

// A manual pay-period adjustment for a creative (camera payback, bonus, etc.).
model PayoutAdjustment {
  id           String     @id @default(cuid())
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  teamMemberId String
  date         DateTime // the date it applies to (falls inside a pay period)
  label        String
  amount       Float // dollars; negative to subtract (e.g. camera payback)
  createdAt    DateTime   @default(now())

  @@index([teamMemberId])
  @@index([date])
}

// A transaction pulled from QuickBooks Online. This is the half of the money
// picture the Hub never had: revenue processed outside Stripe, and the real
// expense ledger. Categorization is automated but never silently guessed --
// anything under the confidence bar lands in the review queue instead.
model QboTransaction {
  id           String   @id @default(cuid())
  qboId        String
  type         String // Invoice | Payment | Purchase | Deposit | SalesReceipt
  txnDate      DateTime
  amount       Float
  balance      Float    @default(0)
  customerName String?
  accountName  String? // QuickBooks' own account/category name
  docNumber    String?

  // Bank-feed text (deposit line descriptions / memo). This is the ONLY signal
  // that distinguishes an owner draw from revenue that detoured through the
  // personal ...0942 account, so it has to be queryable, not buried in `raw`.
  memo        String?
  // How many customer Payments/SalesReceipts this deposit settles. A deposit
  // with zero links and bank-feed text is the shape of a transfer or a duplicate
  // twin; one with links is a genuine settlement.
  linkedCount Int     @default(0)
  // Set when this row is the second copy of a dollar already counted elsewhere
  // (auto-generated receipt + its bank-feed twin). Points at the row we keep.
  duplicateOf String?

  // --- Bookkeeping automation ---
  // Our normalized category, plus how sure we are. needsReview is the flag that
  // puts a row in front of Jordan rather than quietly filing it wrong.
  category    String?
  confidence  Float?
  needsReview Boolean   @default(false)
  reviewNote  String?
  reviewedAt  DateTime?
  // Business vs personal — the split Jordan has never been able to see.
  personal    Boolean   @default(false)

  raw       String? // trimmed source payload, for auditing a bad categorization
  syncedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([qboId, type])
  @@index([txnDate])
  @@index([needsReview])
  @@index([type])
  @@index([category])
}

// ---------------------------------------------------------------------------
// QUARTERLY PERFORMANCE BONUS
//
// Two hard rules the engine must never break:
//  1. SELF-FUNDING. The pool is a share of the quarter's SURPLUS above a
//     threshold the owner sets. A quarter that didn't clear the bar funds a
//     $0 pool. The bonus can never manufacture another December.
//  2. NOTHING PAYS WITHOUT THE OWNER. Scores compute automatically; money only
//     moves when the owner approves, which emits a PayoutAdjustment so the
//     bonus flows through computePayroll into the real P&L like every other cost.
// ---------------------------------------------------------------------------

model BonusPeriod {
  id       String @id @default(cuid())
  // Calendar quarter key, e.g. "2026-Q4". One row per quarter.
  quarter  String @unique
  startKey String // yyyy-mm-dd, ET
  endKey   String // yyyy-mm-dd, ET

  // --- Funding gate (owner-set, snapshotted when the pool is locked) ---
  // Collected revenue and all-in cost for the quarter, as measured at lock time.
  revenue     Float?
  cost        Float?
  // Surplus must exceed this before ANY pool exists.
  threshold   Float  @default(0)
  // Share of surplus-above-threshold that funds the pool (0.03 = 3%).
  poolPercent Float  @default(0.03)
  // The funded pool. Null until computed; 0 is a legitimate, meaningful value.
  poolAmount  Float?
  // Hard ceiling so a blowout quarter can't overcommit cash.
  poolCap     Float?

  status    String    @default("OPEN") // OPEN | LOCKED | PAID
  note      String?
  lockedAt  DateTime?
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  awards BonusAward[]

  @@index([status])
}

model BonusAward {
  id           String      @id @default(cuid())
  period       BonusPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  periodId     String
  teamMember   TeamMember  @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  teamMemberId String

  // OWN = scored on this person's shoots. TEAM = scored on the whole team's
  // results (the manager lane — James is accountable for everyone now).
  basis String @default("OWN") // OWN | TEAM

  // 0..100. Null when the quarter had too little signal to score fairly.
  score     Float?
  // Per-metric breakdown as JSON: [{key,label,weight,value,points,detail,thin}]
  breakdown String?
  // Shoots in the window — the denominator behind every rate, kept for audit.
  shoots    Int     @default(0)

  // Computed share of the pool (score-weighted), then what the owner actually
  // approved. amount is the source of truth for money; suggested is advisory.
  suggested Float?
  amount    Float?
  note      String?

  // Set when approved -> PayoutAdjustment, so we never double-pay on re-run.
  payoutAdjustmentId String?
  paidAt             DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([periodId, teamMemberId])
  @@index([teamMemberId])
}

// Cached daily drive mileage for a creative (home → that day's shoots → home),
// so the payout view doesn't re-route every load. Recomputable on demand.
model MileageDay {
  id            String     @id @default(cuid())
  teamMember    TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  teamMemberId  String
  dayKey        String // yyyy-mm-dd in ET
  miles         Float
  stops         Int        @default(0) // shoots that day (for the route)
  sig           String? // signature of the stop coords — recompute when it changes
  // Owner correction: the miles ACTUALLY driven that day (detour, closed road,
  // multi-stop errand the router can't see). When set it wins over the computed
  // figure everywhere pay is calculated; `miles` keeps the computed value for
  // reference. Cleared = back to automatic.
  overrideMiles Float?
  overrideNote  String?
  computedAt    DateTime   @default(now())

  @@unique([teamMemberId, dayKey])
  @@index([teamMemberId])
}

// A flagged image needing a fix (item removal, perspective, color, etc.). Builds
// a labeled dataset (image + note + tags) for later automated QA/editing. Many
// flags on a project roll up into ONE "fix flagged photos" task for Kyle.
model ImageFlag {
  id         String    @id @default(cuid())
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String
  imageUrl   String // canonical (full-res) image URL
  thumbUrl   String? // thumbnail for display
  caption    String?
  note       String?
  tags       String // JSON array of tag labels
  status     String    @default("OPEN") // OPEN | FIXED
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([projectId])
  @@index([status])
}

// The in-house review room (Frame.io-style). A note is a pin on a photo
// (normalized x/y) or a timestamped comment on a video, routed to a lane:
// EDIT (Kyle fixes it) or PHOTOGRAPHER (capture feedback — kind "fix" needs
// action, "coaching" is do-better-next-time). Threaded via parentId (replies
// carry no pin). ImageFlag stays for the legacy Flags tab; this supersedes it
// for review workflows.
model MediaNote {
  id             String      @id @default(cuid())
  project        Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId      String
  assetUrl       String // canonical media URL (full-res image or video source)
  thumbUrl       String?
  assetType      String      @default("image") // image | video
  x              Float? // normalized 0..1 pin position (photos)
  y              Float?
  timeSec        Float? // video timestamp (seconds)
  lane           String      @default("EDIT") // EDIT | PHOTOGRAPHER | EDITOR
  kind           String      @default("fix") // fix | coaching
  body           String
  status         String      @default("OPEN") // OPEN | FIXED | RESOLVED
  authorKey      String? // "owner" | "tm:<teamMemberId>" | "editor:<key>"
  authorName     String?
  // PHOTOGRAPHER-lane notes: whose capture feedback this is (scopes their view).
  photographer   TeamMember? @relation(fields: [photographerId], references: [id])
  photographerId String?
  // EDITOR-lane notes: whose edit feedback this is (kim/remar/… — the same
  // scoping keys /queue and /editing use). Scopes an editor's view exactly like
  // photographerId scopes a photographer's.
  editorKey      String?
  // Feedback-loop receipts (photographer lane): when the feedback was texted
  // to the creative, when THEY actually opened it (stamped server-side on
  // their own page load — never by an owner/view-as preview), and their
  // explicit "Got it" on coaching notes.
  sharedAt       DateTime?
  seenAt         DateTime?
  acknowledgedAt DateTime?
  parent         MediaNote?  @relation("Thread", fields: [parentId], references: [id], onDelete: Cascade)
  parentId       String?
  replies        MediaNote[] @relation("Thread")
  createdAt      DateTime    @default(now())
  resolvedAt     DateTime?

  @@index([projectId, status])
  @@index([photographerId, status])
}

// One submitted cut awaiting the owner's verdict in the Review Room. Created
// when an editor hits "Done — send to review": we scan the project's FINAL
// Dropbox folder for the newest video, mint a direct streaming link, and park
// it here. The owner reviews at /review/<projectId> (timestamped MediaNotes on
// the same assetUrl), then APPROVES (Kyle delivers) or REQUESTS CHANGES (the
// open EDITOR-lane notes bundle into ONE revision task back on the editor's
// plate). A re-submission after changes is a NEW row with round+1 — rows are
// an audit trail of every cut, never overwritten.
model ReviewSubmission {
  id                       String       @id @default(cuid())
  project                  Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId                String
  kind                     String       @default("video") // video | photos (photos reserved for later)
  assetUrl                 String? // stable playback URL (/api/review/cut/<id>/stream); MediaNotes key on it
  assetPath                String? // Dropbox path of the cut file (folder-discovered rows) or the staging path
  fileName                 String?
  round                    Int          @default(1) // 1 = first cut, +1 per re-submission
  status                   String       @default("PENDING") // UPLOADING | PENDING | CHANGES_REQUESTED | APPROVED
  // ---- Internal upload flow (Sep 1 2026, Jordan: "upload through the editor
  // portal as Version 1 → review room → revisions → approved → auto to
  // Dropbox, marked complete per cut"). A cut is identified by WHICH
  // deliverable and WHICH slot of it (video 2 of 4 on a monthly plan); rounds
  // are versions of that cut. The bytes live in the hub's own store (Vercel
  // Blob — Dropbox temporary links refuse to play in a browser) until the cut
  // is approved and copied to the job's Final folder.
  deliverable              Deliverable? @relation(fields: [deliverableId], references: [id], onDelete: SetNull)
  deliverableId            String?
  /**
   * The 1080p Topaz pass for THIS approved round, if one was queued.
   */
  topazJob                 TopazJob?
  slot                     Int          @default(1) // 1..quantity for multi-video deliverables
  source                   String       @default("folder") // upload | folder | button
  blobUrl                  String? // the uploaded version's URL in the hub store
  blobPathname             String?
  sizeBytes                Int?
  // ---- WHAT ACTUALLY ARRIVED (Sep 16 2026, the 1080p export spec) ----------
  // The rule — lib/videoStyles EXPORT_SPEC, "export at 1080p, edit in 4K if you
  // like" — is only a rule if somebody can see whether it is being followed.
  // TopazJob already stores sourceWidth/sourceHeight, but only for an APPROVED
  // cut that was queued for the finishing pass (one such row exists today), so
  // it cannot answer "are they exporting 1080p now?" for the bounced v1 and v2
  // that are exactly where a 4K habit would show first.
  // Filled three ways, so BOTH doors into review are counted (14 rows came up
  // the upload panel, 12 through the Dropbox folder — measuring only the panel
  // would answer the question for half the cuts):
  //   · at reserve time from the editor's own browser, the same numbers the
  //     upload gate acted on;
  //   · at finish from probeVideoMetadata, when the browser could not read the
  //     file's header (an odd codec, a slow machine);
  //   · at folder discovery from the same probe over a Dropbox temporary link
  //     (lib/reviewCuts recordArrivedDimensions).
  // Null means nothing could be measured — never "it was fine".
  sourceWidth              Int?
  sourceHeight             Int?
  // Set when an OWNER/ADMIN knowingly let an over-spec file through (6pm with a
  // client waiting is its own kind of failure). An EDITOR cannot reach this: an
  // override is a decision with a name on it, not a silent bypass. The job's
  // Activity history carries the same line in words.
  exportOverrideBy         String?
  exportOverrideAt         DateTime?
  finalPath                String? // where the approved cut was placed in Dropbox
  dropboxJobId             String? // files/save_url async job while the copy is in flight
  completedAt              DateTime? // approved AND copied to Dropbox — "complete for that cut"
  submittedByKey           String? // editor key (kim/remar/…)
  submittedByName          String?
  note                     String? // editor's note to the reviewer ("music was client's pick", …)
  decidedAt                DateTime?
  decidedBy                String?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  // ---- REMOVE / REASSIGN (Jordan, Sep 16: "the editor should be able to
  // remove the video from upload / for review in case they mistakenly upload
  // the wrong video or to the wrong project… also reassign that video to a
  // different project", then: "when removing the cut, I want it to remove
  // completely"). Removal DELETES the row and the stored file
  // (src/app/review/actions.ts removeCut); `status` never gains "WITHDRAWN"
  // again, and one Activity line is the only trace kept.
  //
  // The four columns below are LEGACY — carried only by rows written on the
  // afternoon of Sep 16, before removal replaced withdrawal (one such row
  // exists in production, on 328 Columbia Ave). They are still READ, so they
  // stay: CutTakeBackFlags renders the banner, whyNotTakeBack keeps an
  // approved cut office-only, and removeStrandedFinal clears the Dropbox file.
  withdrawnAt              DateTime?
  withdrawnBy              String?
  withdrawnReason          String?
  // LEGACY, same vintage: an APPROVED cut's file was already copied into the
  // job's Final folder, and the old withdrawal left it there. A removal now
  // records that leftover as a SmartTask ("stranded-final-<id>") instead,
  // because the row that used to carry this path is gone.
  strandedFinalPath        String?
  // Reassignment provenance — where the cut came from, so both jobs' timelines
  // and the editor's queue can say what moved.
  movedFromProjectId       String?
  movedAt                  DateTime?
  movedBy                  String?
  // ---- CPOS (Sep 16 2026), spec §8: five separate concepts. Internal QC is
  // status/decidedAt/decidedBy above and stays exactly as it is. These add
  // client VISIBILITY (released), the client's own change request (so the
  // portal stops overwriting Jordan's QC stamp), the client APPROVAL pointer
  // (the ClientDecision row is the record; this is the cache), and the byte
  // hash that makes a cut version immutable ("never silently serve a
  // different file under an old approval").
  clientRequestedAt        DateTime?
  clientRequestedBy        String?
  clientReleasedAt         DateTime?
  clientReleasedBy         String?
  clientApprovedDecisionId String? // -> ClientDecision
  contentHash              String? // sha256 of the stored bytes at release time
  videoId                  String? // -> ContentVideo this cut is a version of

  // ---- "I SENT THIS ONE" (Sep 17 2026) -------------------------------------
  // The durable record that an APPROVED cut's file actually went to the client
  // — the fact src/lib/readyToSend.ts asks for, and the only thing that clears
  // a row off Kyle's "Ready to send" card.
  //
  // WHY IT LIVES HERE AND NOT ON TopazJob. TopazJob.deliveredAt already carries
  // this for a cut that went through the 1080p pass, but two of the three ways
  // a video becomes sendable never produce a TopazJob row at all (the pass was
  // skipped for a reason the editor's own export solves, or the lane is off for
  // that deliverable type), and TopazJob.submissionId is @unique precisely
  // because that table is the RENDER SPEND ledger — a row invented just to hold
  // a delivery stamp would corrupt every cap and count computed off it. The cut
  // is the thing that gets sent, so the cut carries the stamp.
  //
  // WHY THE PROJECT'S OWN deliveredAt WILL NOT DO. Sep 17, 322 N 62nd St: the
  // video went out at 9:17am with no sound, the project was stamped DELIVERED,
  // the file was corrected — and nothing anywhere said whether the correction
  // had been re-sent. A per-job stamp answers "did this job get delivered
  // once"; only a per-cut stamp answers "did THIS FILE go out".
  //
  // Both nullable, no default, nothing reads them until a person presses the
  // button: an additive pair that cannot change the meaning of any existing row.
  sentToClientAt           DateTime?
  sentToClientBy           String?

  // One row per (file, round): the sweep and the editor's button can race on
  // the same new file; Postgres treats the legacy NULL-path rows as distinct.
  @@unique([projectId, assetPath, round])
  @@index([status])
  @@index([projectId, round])
  @@index([deliverableId, slot])
  @@index([videoId])
  @@index([clientReleasedAt])
}

// Per-photo quick verdict while arrowing through a gallery in review mode.
model MediaVerdict {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  assetUrl  String
  verdict   String // APPROVED | NEEDS_WORK
  updatedAt DateTime @updatedAt

  @@unique([projectId, assetUrl])
}

// One row per QC pass, written when a media_qa card completes — the owner's
// quality dial. Snapshots which checklist items Kyle actually ticked (misses =
// unticked-at-completion), the client segment (so VIP misses can be weighted),
// and, if a revision later reopens the QC, when + why (that IS the QC-miss
// event). Read-only analytics; never gates anything.
model QcRecord {
  id                   String    @id @default(cuid())
  project              Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId            String
  clientSegment        String?
  itemsChecked         String // JSON snapshot: [{label, done}]
  missCount            Int       @default(0) // items unticked at completion
  completedBy          String? // assignee key / name
  completedAt          DateTime  @default(now())
  reopenedByRevisionAt DateTime?
  revisionReason       String?

  @@index([projectId])
  @@index([completedAt])
}

// Audit log of every inbound webhook, for debugging + replay.
model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventType   String?
  externalId  String? // provider's event id, for idempotency
  payload     String // raw JSON
  status      String    @default("RECEIVED") // RECEIVED | PROCESSED | ERROR
  error       String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([provider])
  @@index([externalId])
}

// One row per scheduled cron invocation (hourly sync / daily / comms), so a
// failed or skipped step is VISIBLE on /connections (and can Slack-ping) instead
// of vanishing with the HTTP response Vercel throws away. `summary` holds the
// per-step results JSON; `error` the first step error. A row with no finishedAt
// means the run was hard-killed mid-flight.
model CronRun {
  id         String    @id @default(cuid())
  job        String // "sync" | "daily" | "gmail"
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean   @default(false)
  summary    String? // JSON: per-step results + skipped list
  error      String? // first step error, if any

  @@index([job, startedAt])
}

// Platform feedback + feature requests submitted by the team from inside the app.
// Flow: submit → Jordan is notified (email, best-effort) → he Approves/Declines
// in-app → approved items queue for Claude to implement → marked Done when shipped.
model PlatformFeedback {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  kind        String    @default("feature") // feature | bug | feedback
  title       String
  body        String?
  submittedBy String? // free-text name/role of the submitter
  page        String? // where they were when submitting (context)
  screenshot  String? // optional screenshot, stored as a compressed data URL (image/jpeg)
  status      String    @default("NEW") // NEW | APPROVED | DECLINED | DONE
  priority    String? // optional triage label set on approval
  adminNote   String? // Jordan's note on decision
  decidedAt   DateTime?

  @@index([status])
}

// Distilled business knowledge for "Ask the Hub" — durable facts about how
// RealTour Pilot operates, learned from Jordan's ChatGPT history + the playbook.
// Each item carries the MINIMUM role allowed to see it, mapping onto the future
// per-user RBAC (CREATIVE < ADMIN < OWNER). The assistant filters retrieval by
// the current viewer's role so private knowledge never reaches the wrong person.
model KnowledgeItem {
  id         String   @id @default(cuid())
  category   String // preference | goal | issue | outcome | sop | fee | client_insight | strategy | financial | team | comms | script | pricing
  title      String
  body       String // the insight, written concisely and factually
  minRole    String   @default("ADMIN") // CREATIVE | ADMIN | OWNER (lowest role allowed to see it)
  tags       String? // JSON string[]
  source     String   @default("chatgpt-export") // chatgpt-export | playbook | manual
  sourceRef  String? // provenance: conversation title/id or note
  confidence Int? // 1-5, how strongly the source supports this
  pinned     Boolean  @default(false) // always-surface core facts
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([category])
  @@index([minRole])
  @@index([archived])
}

// Full-text communications log for "Ask the Hub" comms memory. Unlike Activity
// (truncated, project-scoped timeline), this stores the FULL body of every
// client text, call transcript, email, and note, kept live by the OpenPhone +
// Gmail webhooks/crons and outbound sends. Lets the assistant answer "what did
// we tell this client / when did we last talk / what was promised". Client comms
// are sensitive: surfaced to ADMIN+OWNER only, never to creatives.
model CommLog {
  id           String   @id @default(cuid())
  channel      String // text | call | email | slack | note
  direction    String   @default("in") // in | out
  minRole      String   @default("ADMIN") // CREATIVE | ADMIN | OWNER — lowest role allowed to see it (Slack DMs = OWNER)
  clientId     String? // plain ref (no FK) so log rows survive client edits
  clientName   String?
  projectId    String?
  contactName  String? // who sent/received (sender label)
  // The OTHER party's phone, 10-digit key (inbound: who wrote in; outbound: who
  // we texted). Without it a logged text can be read but not replied to — the
  // reply queue needs a number to send back on, and CommLog is the only complete
  // record of every text. Null on email/slack rows and on texts logged before
  // this column existed (those fall back to the client's number on file).
  fromPhone    String?
  subject      String? // email subject, if any
  body         String // full message text / transcript
  occurredAt   DateTime
  source       String // openphone | openphone-call | gmail | slack | manual | backfill
  externalId   String?  @unique // dedup: provider message/call id
  // TRUE when projectId is a router HEURISTIC (mostRelevantProject /
  // mostRecentDeliveredIsh fallback for a message naming no street) rather
  // than a named street/thread match or an explicit send. Surfaces that scope
  // by project (e.g. the /ops shoot-card comms chip) must not treat a guessed
  // filing as proof the message is about that job.
  projectGuess Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([clientId])
  @@index([projectId])
  @@index([occurredAt])
  @@index([minRole])
  // The reply queue scans recent texts newest-first; without this it table-scans.
  @@index([channel, occurredAt])
  @@index([fromPhone])
}

// Persisted "Ask the Hub" conversations. Powers the owner-only chat-history +
// analytics view (what the team asks the brain, and how it answered). `role` is
// the viewer tier the chat was held under — a stand-in for a real user id until
// per-user accounts land. Summaries are generated lazily and cached on the row.
model HubChat {
  id             String       @id @default(cuid())
  role           String       @default("OWNER") // OWNER | ADMIN | CREATIVE (who was asking)
  userEmail      String? // the signed-in person who had this conversation
  userName       String? // display name at the time (denormalized for history)
  title          String? // short heuristic/AI title
  summary        String? // detailed recap, lazy-generated + cached
  summaryAtCount Int          @default(0) // messageCount when the summary was last built
  category       String? // dominant question category, for quick scanning
  messageCount   Int          @default(0)
  createdAt      DateTime     @default(now())
  lastMessageAt  DateTime     @default(now())
  messages       HubMessage[]

  @@index([lastMessageAt])
}

model HubMessage {
  id        String   @id @default(cuid())
  chat      HubChat  @relation(fields: [chatId], references: [id], onDelete: Cascade)
  chatId    String
  role      String // user | assistant
  content   String
  category  String? // question category (set on user turns), derived from tools used
  toolsUsed String? // JSON string[] of tool names (assistant turns)
  createdAt DateTime @default(now())

  @@index([chatId])
  @@index([category])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Auth + RBAC. People who can LOG IN to the hub. Separate from TeamMember (the
// operational roster) but optionally linked to it. Login is Google-OAuth-only and
// restricted to rows that exist here (an allowlist) — random Google accounts are
// denied. `role` drives default page access + the content-sensitivity tier; the
// `permissions` JSON overrides specific pages per person.
// ---------------------------------------------------------------------------
model AppUser {
  id                  String    @id @default(cuid())
  email               String    @unique // Google login email, lowercased
  name                String?
  role                String    @default("PHOTOGRAPHER") // OWNER | ADMIN | EDITOR | PHOTOGRAPHER
  permissions         String? // JSON: per-page overrides, e.g. {"billing":true,"clients":false}
  status              String    @default("INVITED") // INVITED | ACTIVE | DISABLED
  // scrypt hash (salt:hash) for email+password login — an ALTERNATIVE to Google
  // sign-in so contractors on personal emails don't need a Workspace account.
  // Never plaintext; set by the user themselves via the set-password link.
  passwordHash        String?
  inviteToken         String?   @unique
  invitedAt           DateTime?
  lastLoginAt         DateTime?
  notificationsSeenAt DateTime? // bell "unread" watermark; null = never opened
  teamMemberId        String? // optional link → TeamMember (a photographer's shoots)
  editorKey           String? // optional link → editor roster (kim/remar/…) for "delegated to me"
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status])
}

// ---------------------------------------------------------------------------
// In-app notifications (the bell). One row per event PER TARGET: a role
// broadcast (userKey null) or one person (userKey "tm:<teamMemberId>" /
// "editor:<editorKey>" — the same scoping keys /queue and /editing use; role
// still required either way). Written best-effort by notifyInApp() next to the
// existing Slack pings/tasks — never a replacement for them. Unread is a single
// per-user watermark (AppUser.notificationsSeenAt), no per-row read state.
// Retention: the daily cron deletes rows older than 90 days.
// ---------------------------------------------------------------------------
model Notification {
  id        String   @id @default(cuid())
  kind      String // order_booked | order_paid | delivery_out | revision_raised | revision_resolved | appointment_change | new_lead | raws_landed | edit_finished | shoot_completed | client_feedback | mention | system
  title     String // <= 90 chars, e.g. "Delivered — 320 Tarbert Dr"
  body      String? // one line; notifyInApp strips it for creative audiences
  href      String // in-app deep link: /projects/<id> | /billing | /editing | /queue | /connections | /feedback | /shoot
  audience  String // JSON Role[] e.g. ["OWNER","ADMIN"]
  userKey   String? // null = role broadcast; "tm:<id>" | "editor:<key>" = that person only
  dedupeKey String?  @unique
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// PLAID — read-only bank/card connections. This is the OTHER missing half of
// the money picture the forensic audit exposed: the business QuickBooks only
// sees business checking + Stripe, while real business costs also flow through
// Jordan's PERSONAL account (...0942), personal Venmo, and credit cards — none
// of which QuickBooks can see. Plaid pulls transaction history + balances from
// those accounts (read-only; Plaid cannot move money). The per-bank access
// token is the sensitive credential and lives ENCRYPTED here, never in the
// browser. Jordan authenticates each bank inside Plaid Link — we never see the
// bank login. `isBusiness` lets the owner tag each account so the finance
// engine can separate true business cost from personal, and net the two-way
// transfers the audit found between checking and ...0942.
// ---------------------------------------------------------------------------
// The $5k/month savings plan as a living checklist (from the 2026-07-22
// cost-optimization audit). Owner ticks items off on the Overview; done items
// sum into "reclaimed $/mo". Additive, seeded once, owner-editable via toggle.
model SavingsItem {
  id            String    @id @default(cuid())
  rank          Int
  title         String
  detail        String?
  savesPerMonth Float // conservative $/mo
  tier          String // "instant" | "setting" | "habit" | "decision"
  status        String    @default("PENDING") // PENDING | DONE | SKIPPED
  doneAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model PlaidItem {
  id                   String    @id @default(cuid())
  itemId               String    @unique // Plaid item_id (one per connected institution login)
  accessTokenEncrypted String // AES-GCM blob (see integrations/crypto.ts) — the read-only access token
  institutionId        String?
  institutionName      String? // e.g. "Capital One", "Chase"
  cursor               String? // /transactions/sync incremental cursor
  status               String    @default("ACTIVE") // ACTIVE | ERROR | DISCONNECTED
  lastError            String?
  lastSyncedAt         DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  accounts PlaidAccount[]

  @@index([status])
}

model PlaidAccount {
  id               String    @id @default(cuid())
  item             PlaidItem @relation(fields: [plaidItemId], references: [id], onDelete: Cascade)
  plaidItemId      String
  accountId        String    @unique // Plaid account_id
  name             String? // e.g. "Business Checking"
  officialName     String?
  mask             String? // last 4, e.g. "0942"
  type             String? // depository | credit | loan | investment
  subtype          String? // checking | savings | credit card | …
  currentBalance   Float?
  availableBalance Float?
  isoCurrency      String?
  // Owner-tagged: is this a BUSINESS account or PERSONAL? Drives whether its
  // spend counts as a business cost or an owner draw in the finance engine.
  // null = untagged (surfaced for the owner to classify).
  isBusiness       Boolean?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  transactions PlaidTransaction[]

  @@index([plaidItemId])
}

model PlaidTransaction {
  id              String       @id // Plaid transaction_id (natural key; upsert on it)
  account         PlaidAccount @relation(fields: [accountId], references: [accountId], onDelete: Cascade)
  accountId       String // Plaid account_id
  // Plaid sign convention: POSITIVE = money OUT of the account (debit/spend),
  // NEGATIVE = money IN (deposit/credit). The finance layer must honor this.
  amount          Float
  isoCurrency     String?
  date            DateTime // posted date
  authorizedDate  DateTime?
  name            String?
  merchantName    String?
  category        String? // Plaid personal_finance_category.primary
  categoryDetail  String? // personal_finance_category.detailed
  paymentChannel  String? // online | in store | other
  pending         Boolean      @default(false)
  // --- Our finance categorization (financeCategories.ts) ---
  // financeKind: BUSINESS | PERSONAL | EXCLUDE (self-transfer / card paydown /
  // topup — money movement, not spend) | REVIEW (needs a human call).
  financeKind     String? // null = not yet categorized
  financeCategory String? // human label, e.g. "Restaurants & food delivery"
  // Owner re-tagged this row by hand — the auto-categorizer must NOT overwrite it.
  financeLocked   Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([accountId])
  @@index([date])
  @@index([financeKind])
  @@index([pending])
}

// AI-generated financial reports/statements (Advisor tab) — rendered at
// /sales/report/[id] as a printable statement the owner exports to PDF.
model FinanceReport {
  id        String   @id @default(cuid())
  title     String
  type      String // pnl | spending | people | personal | monthly | custom
  startKey  String // YYYY-MM-DD period covered
  endKey    String
  markdown  String // the statement body (markdown)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Personal budget targets (Budget tab) — one row per personal category. Set by
// the owner inline or by the AI Advisor (set_budget tool). Compared monthly
// against personalTruth actuals.
model BudgetTarget {
  id            String   @id @default(cuid())
  category      String   @unique // personal category label, e.g. "Groceries"
  monthlyTarget Float
  note          String? // advisor's one-line reasoning for this number
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

// The AI growth plan behind the Trends page — new packages, promotions, what to
// focus on and what to fix. One live row ("default"). `snapKey` hashes the
// business numbers it was built from, so it rebuilds when the business actually
// moves rather than rewording itself on every page load.
// ---------------------------------------------------------------------------
// THE OWNER'S OWN TO-DOS. Deliberately NOT SmartTask.
//
// SmartTask is the shared ops queue: ~1,080 machine-minted rows, no per-user
// privacy, and several sweeps that bulk-mutate status. Two of them would eat a
// personal to-do outright — closeObsoleteTasks cancels EVERY open task on a
// project when Aryeo cancels the order, and the Gmail reply sweep completes any
// task carrying a gmail thread once we answer that thread. Neither filters on
// taskType or source. A personal list that silently loses items is worse than
// no list, so this lives in its own table where nothing automated touches it.
//
// It also needs fields SmartTask has no business carrying: which part of the
// day the work belongs in, how long to block, and the Google Calendar event id
// once that block exists.
// ---------------------------------------------------------------------------
model OwnerTodo {
  id          String    @id @default(cuid())
  title       String
  notes       String?
  status      String    @default("OPEN") // OPEN | DONE | DROPPED
  // NOW = today's must-do, NEXT = this week, LATER = someday. Three buckets on
  // purpose: a long flat list is the thing that stops getting looked at.
  priority    String    @default("NEXT")
  // DEEP work wants the protected morning; SHALLOW (admin, calls, errands)
  // fills the afternoon. Drives where the day planner places it.
  energy      String    @default("SHALLOW")
  estimateMin Int       @default(30) // how much calendar time to block
  dueAt       DateTime?
  doneAt      DateTime?

  // What it is ABOUT — any or none of these.
  project       Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId     String?
  client        Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId      String?
  // A text or call thread (CommLog.id) and/or an email thread. Stored as plain
  // ids rather than a `source` string so no sweep can pattern-match them.
  commLogId     String?
  gmailThreadId String?
  gmailMailbox  String?
  sourceNote    String? // free-text "where this came from"

  // Scheduling. plannedFor is an ET day key (YYYY-MM-DD) — the day it is slotted
  // into. blockStart/End + calendarEventId are filled once it is on the calendar.
  plannedFor      String?
  blockStart      DateTime?
  blockEnd        DateTime?
  calendarEventId String?

  // Set when this to-do came out of a meeting transcript.
  meeting   OwnerMeeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  meetingId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, plannedFor])
  @@index([projectId])
  @@index([meetingId])
}

// A meeting whose transcript was read into a summary + proposed action items.
// The action items are REVIEWED, not auto-created: an auto-filled list you stop
// believing is worse than no list. Accepting the card mints its OwnerTodos.
model OwnerMeeting {
  id         String    @id @default(cuid())
  title      String
  heldAt     DateTime
  source     String    @default("google_meet")
  sourceId   String?   @unique // Drive file id, so a re-scan cannot duplicate it
  summary    String? // the detailed recap
  transcript String? // trimmed source text, for auditing a bad action item
  // Proposed action items awaiting review: JSON [{title, notes, dueAt, energy}].
  proposed   String?
  draftEmail String? // AI-drafted follow-up, owner sends it or doesn't
  status     String    @default("REVIEW") // REVIEW | ACCEPTED | DISMISSED
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  todos OwnerTodo[]

  @@index([heldAt])
  @@index([status])
}

// Per-package margin, precomputed. Costing a year of shoots runs the whole
// payroll engine, which reaches the PUBLIC OSRM router over the network for
// mileage — fine in a nightly cron, fatal in a page request (it timed out a
// 60-second serverless function while taking 3s against a warm local cache).
// The page reads this row and never computes.
model MarginSnapshot {
  id        String   @id @default(cuid())
  scope     String   @unique // "ytd"
  startKey  String // YYYY-MM-DD window covered
  endKey    String
  json      String // PackageMargins
  builtAt   DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GrowthPlan {
  id        String   @id @default(cuid())
  scope     String   @unique // "default" — room for per-segment plans later
  snapKey   String // hash of the snapshot the plan was built from
  json      String // GrowthPlanData
  builtAt   DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A document Ask the Hub wrote and SAVED — a report, an SOP, a brief, a plan.
// The finance advisor could already do this (FinanceReport), but only for
// formal financial statements over a date range. This is the general case: any
// question that deserves a document rather than a chat bubble that scrolls away.
// Owner/admin-editable platform settings (/settings). One row per key, value
// is JSON. Read through src/lib/settings.ts (cached, code-default fallback) so
// a missing row never breaks anything — the code default IS the setting until
// someone changes it in the UI.
model AppSetting {
  key       String   @id
  value     String // JSON
  updatedAt DateTime @updatedAt
  updatedBy String? // email of who last changed it
}

model HubDocument {
  id        String   @id @default(cuid())
  title     String
  kind      String   @default("report") // report | sop | brief | plan | summary | doc
  markdown  String // the document body — this IS the document
  // What was asked for, so a stale doc can be regenerated without guessing.
  prompt    String?
  createdBy String? // the signed-in name/email that asked for it
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([kind])
}

// ---------------------------------------------------------------------------
// CONTENT CREATOR PROGRAM (monthly personal branding). The enrollment signal
// is Client.socialClient/socialPlan (synced from Aryeo custom fields); these
// models are the program's operating layer on top of the existing pipeline.
// Content sessions ARE Aryeo appointments -> Projects (Project.contentMonthId).
// ---------------------------------------------------------------------------

// The client's video LIBRARY — one row per delivered content-program video,
// materialized (Jordan, Aug 28: "backfill everything for all the clients, and
// from then on it gets added once it passes QC and is uploaded to Dropbox").
// Two sources feed it: the Aryeo backfill/sweep (history — the CDN links the
// delivery emails use) and the Review Room approve hook (a QC-passed cut's
// Dropbox streaming link, the instant Jordan approves). The portal reads ONLY
// this table — no live Aryeo calls on a client page load.
model PortalVideo {
  id           String   @id @default(cuid())
  enrollmentId String // -> ContentEnrollment (plain ref)
  monthId      String? // -> ContentMonth
  projectId    String? // -> Project
  title        String?
  thumb        String?
  playback     String? // streamable URL (Aryeo CDN or Dropbox direct link)
  download     String?
  source       String // aryeo | review
  externalKey  String   @unique // aryeo:<listingId>:<n> | sub:<submissionId> — sync idempotency
  deliveredAt  DateTime
  createdAt    DateTime @default(now())

  // ---- CPOS (Sep 16 2026), spec §7: a library row is one SOURCE of one
  // logical video, never the video itself — so an Aryeo row and a review-cut
  // row for the same deliverable count once.
  videoId      String? // -> ContentVideo
  submissionId String? // -> ReviewSubmission, for source = review
  label        String? // PROGRAM | LISTING | EXTRA — null = legacy, treated as PROGRAM by readers until staff map it

  @@index([enrollmentId, deliveredAt])
  @@index([videoId])
}

// A client's suggested change to one of their scripts, straight from the
// portal (interactive layer, Aug 28). NEVER overwrites the script — it sits
// OPEN until a human applies it (AI rewrite, original body snapshotted here)
// or dismisses it. Spec rule: client suggestions create records, not edits.
model ScriptSuggestion {
  id           String    @id @default(cuid())
  scriptId     String // -> ContentScript (plain ref)
  enrollmentId String // -> ContentEnrollment (plain ref, the token's owner)
  body         String // the client's ask, their words
  status       String    @default("OPEN") // OPEN | APPLIED | DISMISSED
  originalBody String? // the script body BEFORE an applied rewrite
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  // ---- CPOS (Sep 16 2026), spec §2/§22: who asked, and against which
  // script version, so a suggestion on v2 is never applied to v4 blind.
  clientUserId    String?
  staffUserId     String?
  scriptVersionId String? // -> ContentScriptVersion

  @@index([scriptId])
  @@index([enrollmentId, status])
}

// A client's timestamped note on one of their cuts, from the portal player.
// OPEN notes pile up while they watch; "Request changes" bundles them into
// ONE revision (raiseRevision -> RevisionBrief work order) and marks them
// SENT. Kept separate from MediaNote on purpose: the internal lanes'
// counters, bundlers and sweeps must not see client rows.
model PortalComment {
  id           String   @id @default(cuid())
  submissionId String // -> ReviewSubmission (plain ref)
  projectId    String // -> Project (plain ref)
  enrollmentId String // -> ContentEnrollment (plain ref)
  timeSec      Float? // null = a general note
  body         String
  status       String   @default("OPEN") // OPEN | SENT | RESOLVED
  createdAt    DateTime @default(now())

  // ---- CPOS (Sep 16 2026), spec §8: who wrote it (a person, or staff on
  // their behalf; both null = legacy token visit), replies, and resolution.
  clientUserId   String? // -> ClientUser
  staffUserId    String? // -> AppUser, when written through the owner iframe
  parentId       String? // -> PortalComment (a reply thread)
  resolvedAt     DateTime?
  resolvedBy     String?
  resolvedByKind String? // CLIENT | STAFF | EDITOR
  decisionId     String? // -> ClientDecision that bundled this note
  videoId        String? // -> ContentVideo
  updatedAt      DateTime? @updatedAt // nullable (additive on a live table) but Prisma-maintained on every write

  @@index([submissionId])
  @@index([projectId, status])
  @@index([enrollmentId])
  @@index([parentId])
  @@index([decisionId])
}

// A PAID website signup, one row per Stripe Checkout session — the activation
// ledger for the Content Program (Jordan, Aug 28: the website already handles
// package selection -> agreement -> Stripe Checkout -> Calendly; the hub just
// never heard about it). checkoutId is the idempotency key: however many times
// the sweep re-reads Stripe, one payment activates exactly one enrollment.
// Money fields live here and on the enrollment's owner-only billing block —
// never on any creative surface.
model ProgramSignup {
  id               String   @id @default(cuid())
  checkoutId       String   @unique // Stripe checkout.session id
  subscriptionId   String? // present on monthly plans; watched for lapses
  stripeCustomerId String?
  email            String?
  name             String?
  phone            String?
  productId        String
  productName      String // e.g. "Video Accelerator - 1-Year Commitment"
  priceId          String?
  amount           Float // dollars, as paid at checkout
  recurring        Boolean
  paidAt           DateTime
  clientId         String? // -> Client (plain ref, matched or created)
  enrollmentId     String? // -> ContentEnrollment (plain ref)
  status           String   @default("ACTIVATED") // ACTIVATED | NEEDS_REVIEW
  note             String? // why NEEDS_REVIEW, package conflicts, etc.
  createdAt        DateTime @default(now())

  @@index([enrollmentId])
}

model ContentEnrollment {
  id                   String    @id @default(cuid())
  clientId             String    @unique // -> Client (plain ref)
  package              String // Starter | Accelerator | Pro (display name, configurable)
  videosPerMonth       Int
  sessionsPerMonth     Int
  sessionHours         Float // per-session cap (2 or 4)
  // Per-client workflow overrides (spec §3): the flags every engine must honor.
  strategyCallRequired Boolean   @default(true)
  clientSuppliesTopics Boolean   @default(false)
  overridesJson        String? // anything rarer, JSON
  status               String    @default("ACTIVE") // ACTIVE | PAUSED | ENDED
  // --- Billing terms (owner-entered, Aug 25) — how this client pays. ---
  // PAID_IN_FULL (rate = the full amount) | MONTHLY_CONTRACT (rate = per month,
  // months = commitment) | MONTH_TO_MONTH (rate = per month) | TRIAL (rate = the
  // one-month price). Never shown to creatives.
  billingType          String?
  billingRate          Float?
  billingMonths        Int?
  // Phase-5 portal: unguessable share token — the client's read-only page of
  // their approved scripts + booking link. Null = no portal issued yet.
  portalToken          String?   @unique
  // A human set the status (trials that aren't Aryeo-flagged, hand-pauses):
  // the Aryeo sync must never auto-pause or auto-reactivate these.
  statusManual         Boolean   @default(false)
  startedAt            DateTime?
  packageSource        String    @default("aryeo") // aryeo | manual (who set the package)
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // ---- CPOS (Sep 16 2026) — see the CONTENT PROGRAM OPERATING SYSTEM block.
  // Token lifecycle (spec §2): the value above already exists; these say when
  // it was minted, when it stops working, and when it was last rotated. Null
  // expiry = the link keeps working exactly as today (transition Stage A).
  portalTokenIssuedAt  DateTime?
  portalTokenExpiresAt DateTime?
  portalTokenRotatedAt DateTime?
  // Paused/ended clients keep READ-ONLY access to released content unless a
  // human explicitly revokes it (Jordan's ruling). Null = not revoked.
  accessRevokedAt      DateTime?
  accessRevokedBy      String?
  // Call mode (spec §17): REQUIRED | OPTIONAL_WRITTEN | NOT_INCLUDED. Null =
  // derive from strategyCallRequired (true→REQUIRED, false→NOT_INCLUDED) so
  // nothing changes for the 28 live rows until a human sets it.
  callMode             String?
  // Whether this client may choose "Plan without a call" (spec §19). Null =
  // the program default (offered when callMode is OPTIONAL_WRITTEN).
  noCallEligible       Boolean?
  timezone             String? // IANA, for appointment display + reminder hours; null = America/New_York

  @@index([status])
}

model ContentMonth {
  id                    String    @id @default(cuid())
  enrollmentId          String
  clientId              String // denormalized for cheap client-scoped reads
  monthKey              String // "2026-08" (ET month)
  videosOwed            Int
  status                String    @default("OPEN") // OPEN | COMPLETED | SKIPPED | IMPORTED
  historical            Boolean   @default(false) // backfilled month — never went through the live workflow
  // Strategy call (spec §16) — richer StrategyCall model arrives in Phase 3;
  // these fields carry the state the dashboard needs now.
  strategyCallStatus    String    @default("NOT_SCHEDULED") // NOT_REQUIRED | NOT_SCHEDULED | SCHEDULED | COMPLETED | SKIPPED
  strategyCallAt        DateTime?
  // Calendly linkage: the booked event's uri (dedupe + cancel detection) and
  // the transcript source doc, so a call is never ingested twice.
  calendlyEventUri      String?
  transcriptSource      String? // drive:<fileId> | paste
  transcriptText        String? // manual paste until Meet automation lands
  transcriptProcessedAt DateTime?
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // ---- CPOS (Sep 16 2026), spec §19: a month has a planning mode and a
  // preparation status SEPARATE from appointment status. All nullable — the
  // derivation rules live in code, and null means "not yet decided", never
  // "call completed".
  planningMode               String? // CALL | WRITTEN | UNDECIDED
  preparationStatus          String? // CALL_PLANNED | WRITTEN_SELECTED | AWAITING_ANSWERS | PREPARING_SCRIPTS | AWAITING_SCRIPT_APPROVAL | READY_FOR_FILMING
  preparationCompletedAt     DateTime? // no-call path: when sufficient answers were submitted (starts the window)
  preparationWindowDays      Int? // null = the configured default (3 business days)
  preparationExceptionReason String? // staff applied an established exception
  preparationExceptionBy     String?
  preparationExceptionAt     DateTime?
  filmingReadyAt             DateTime? // stamped when scripts are approved AND preparation is complete
  // This month's campaign/priorities (spec §3), kept apart from the permanent
  // brand foundation that lives on ContentStrategyVersion.
  prioritiesJson             String?
  prioritiesSourceRef        String? // ProgramCallRecord id | ClientFact id | "manual"
  // The monthly-strategy call that PLANNED this month (spec §26: a call held
  // in late September may plan October). Replaces keying by the call's month.
  callRecordId               String?
  // Staff snooze for the reminder evaluator (spec §24).
  remindersSnoozedUntil      DateTime?
  remindersSnoozedBy         String?
  remindersSnoozeReason      String?

  @@unique([enrollmentId, monthKey])
  @@index([clientId])
  @@index([monthKey])
  @@index([callRecordId])
  @@index([preparationStatus])
}

model ContentTopic {
  id            String   @id @default(cuid())
  enrollmentId  String
  clientId      String
  monthId       String? // null = in the bank; set = planned for that month
  title         String
  concept       String? // short angle / why it works
  pillar        String?
  source        String   @default("staff") // ai | client | strategy_call | staff | import
  status        String   @default("IDEA") // IDEA | RECOMMENDED | SAVED | SELECTED | SCRIPTED | FILMED | EDITING | DELIVERED | REJECTED | ARCHIVED
  clientVisible Boolean  @default(false) // shown in the portal (server-enforced)
  scoresJson    String? // {trust, credibility, value, entertainment} High/Med/Low + rationale
  clientWording String? // the client's original phrasing, preserved (spec §19)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // ---- CPOS (Sep 16 2026), spec §5: "a topic title alone is insufficient".
  // `pillar` above stays as the free-text label (≈200 distinct strings in
  // production); `pillarId` is the stable identity. `concept` above IS the
  // Arielle-style one-sentence description — not duplicated here.
  pillarId          String? // -> ContentPillar
  audienceNeed      String? // the problem, misconception or opportunity
  businessGoal      String? // which approved goal this serves
  intendedMessage   String? // what the viewer should take away
  // Approval state is separate from the production `status` above: a topic
  // can be SELECTED by a client and still not approved by staff. Null = legacy
  // row, treated as PROPOSED by readers.
  approvalState     String? // PROPOSED | APPROVED | REJECTED | ARCHIVED
  approvedBy        String?
  approvedAt        DateTime?
  rejectionReason   String? // kept internally so the same idea is not re-suggested
  archiveReason     String?
  // Provenance — which record produced this topic, so an import is traceable
  // to source text and a refresh cannot re-create it.
  sourceRef         String? // free-form pointer for legacy sources
  importItemId      String? // -> ContentImportItem
  suggestionId      String? // -> ContentTopicSuggestion (accepted from a refresh)
  strategyVersionId String? // -> ContentStrategyVersion in force when created
  policyVersionId   String? // -> ProgramGenerationPolicyVersion
  clientUserId      String? // -> ClientUser, when the client suggested it
  // Import of Jordan's colour-marked banks (manifest §5.3): the mark is a
  // PROPOSAL for staff to confirm, never a filmed/delivered fact.
  importedMark      String? // bold-red | red | green | bold | turquoise | none
  proposedState     String? // what the mark suggests: SCRIPTED | SELECTED | PARKED
  dedupeHash        String? // normalized title hash inside one enrollment
  lastEventAt       DateTime?

  @@index([clientId])
  @@index([monthId])
  @@index([status])
  @@index([pillarId])
  @@index([enrollmentId, dedupeHash])
  @@index([importItemId])
}

model ContentScript {
  id             String   @id @default(cuid())
  enrollmentId   String
  clientId       String
  monthId        String?
  topicId        String?
  title          String
  body           String // the full spoken script, clean
  sectionsJson   String? // {hook, rehook, buildup, payoff, cta} when structured
  productionJson String? // optional B-roll/props/overlay ideas (spec §26) — not spoken copy
  status         String   @default("DRAFT") // DRAFT | INTERNAL_REVIEW | APPROVED | CLIENT_VISIBLE | READY_TO_FILM
  clientVisible  Boolean  @default(false)
  source         String   @default("ai") // ai | manual | import
  sourceFile     String? // original uploaded filename for backfilled scripts
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // ---- CPOS (Sep 16 2026). The script row is the stable identity; the words
  // live in ContentScriptVersion (spec §6/§22: edits after sharing create a
  // new draft, never alter an approved one). `body`/`sectionsJson` above stay
  // as the legacy copy of whatever version is current.
  currentVersionId  String? // -> ContentScriptVersion (latest draft or approved)
  approvedVersionId String? // -> the version Jordan approved
  sharedVersionId   String? // -> the version released to the portal
  approvedAt        DateTime? // approveScript has stamped nothing until now
  approvedBy        String?
  sharedAt          DateTime?
  // Imported scripts are HISTORICAL records (Jordan's ruling): import ≠
  // approved/filmed/released. The 131 APPROVED imports stay visible as
  // history via releaseState = "historical"; null = legacy status-driven.
  historical        Boolean   @default(false)
  releaseState      String? // historical | released | withheld
  // Explicit links (spec §9: never AI-match what production can record).
  pillarId          String? // -> ContentPillar
  strategyVersionId String? // -> ContentStrategyVersion
  policyVersionId   String? // -> ProgramGenerationPolicyVersion
  interviewId       String? // -> ContentInterview (written-answer path)
  callRecordId      String? // -> ProgramCallRecord (call path)
  importItemId      String? // -> ContentImportItem
  videoId           String? // -> ContentVideo, once filmed (scripts live with their video)

  @@index([clientId])
  @@index([monthId])
  @@index([topicId])
  @@index([videoId])
  @@index([importItemId])
  @@index([status, historical])
}

// The living Agent Profile (spec §6): six editable sections stored as JSON so
// the shape can evolve without migrations. Forms read/write named keys.
model AgentProfile {
  id               String   @id @default(cuid())
  clientId         String   @unique
  brandJson        String? // positioning, audience, message, pillars, goals
  voiceJson        String? // tone dials, phrases, script-format preferences
  contentPrefsJson String? // topics loved/banned, formats, comfort levels
  productionJson   String? // locations, days, teleprompter, wardrobe
  editingJson      String? // persistent edit style (distinct from job notes)
  storiesJson      String? // stories, POVs, expertise, local knowledge
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())
}

// Chronological program notes. intelligence=true rows feed AI context;
// ordinary operational notes never pollute prompts (spec §6.10).
model ContentNote {
  id           String   @id @default(cuid())
  clientId     String
  body         String
  authorName   String?
  intelligence Boolean  @default(false)
  createdAt    DateTime @default(now())

  // ---- CPOS (Sep 16 2026), spec §23: ContentNote STAYS for migration. Each
  // note that has been turned into a structured ClientFact points at it, so
  // the 804 rows can be walked once and prompts can switch to facts without
  // a data drop.
  migratedFactId String? // -> ClientFact
  migratedAt     DateTime?

  @@index([clientId])
  @@index([migratedFactId])
}

// The client's Content Strategy (spec §8) — structured sections, not a PDF.
// Phase 1 ships the IMPORT path (Jordan's existing strategies, uploaded and
// parsed); Phase 2 adds AI generation from Brand Discovery + the alignment
// state ladder. One ACTIVE strategy per client at a time; history preserved.
model ContentStrategy {
  id           String   @id @default(cuid())
  enrollmentId String
  clientId     String
  // Structured sections (JSON, keys are section names): positioning, audience,
  // message, goals, pillars, tone, preferences, businessContext.
  sectionsJson String
  rawText      String? // full original text, for provenance + AI context
  status       String   @default("ACTIVE") // DRAFT | INTERNAL_REVIEW | ALIGNED | ACTIVE | ARCHIVED
  source       String   @default("import") // import | ai | manual
  sourceFile   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // ---- CPOS (Sep 16 2026), spec §3: the strategy row is the stable identity;
  // every edit/import/generation is a ContentStrategyVersion. These pointers
  // say which version is being worked on, which one Jordan approved (with
  // who/when), and which one the client can see. Null = pre-versioning row.
  currentVersionId  String?
  approvedVersionId String?
  approvedAt        DateTime?
  approvedBy        String?
  releasedAt        DateTime? // client-visible under the release policy
  releasedBy        String?
  structureTemplate String? // S1 | S2 | S3 | POLICY — which section hierarchy the source follows (manifest §3.3)

  @@index([clientId])
  @@index([enrollmentId, status])
}

// Queued team SMS for digest batching (Aug 24: Harrison & James were getting
// blown up with back-to-back texts). First ping in a window sends instantly;
// the rest queue and flush as ONE combined message. Sent rows stay as a log.
model PendingSms {
  id           String    @id @default(cuid())
  teamMemberId String
  line         String // one digest line: "title → link"
  createdAt    DateTime  @default(now())
  sentAt       DateTime?
  // Sep 16: a line that can never send (non-US number) is parked once instead
  // of being retried every five minutes.
  skippedAt    DateTime?
  skipReason   String?

  @@index([teamMemberId, sentAt])
  @@index([sentAt])
}

// Who changed what on the login roster — the Kyle role-flip (Aug 18) was
// unattributable because account changes kept no history (audit Aug 25).
model AuditLog {
  id        String   @id @default(cuid())
  actor     String // email of who made the change
  action    String // role_change | permission_change | status_change | invite
  target    String // email of the affected account
  detail    String // human-readable before -> after
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([target])
}

// Sep 16 (Kyle call, item 4): what actually went out, per person and channel —
// bell rows are durable, texts were only a claim stamp and Slack DMs were not
// recorded at all. Written at the three send points in src/lib/notify.ts.
model NotificationDelivery {
  id             String   @id @default(cuid())
  notificationId String?
  teamMemberId   String
  kind           String
  channel        String // slack | sms | bell
  status         String // sent | queued | failed | skipped
  detail         String? // Slack error text, PendingSms id, or the skip reason
  createdAt      DateTime @default(now())

  @@index([teamMemberId, createdAt])
  @@index([notificationId])
}

// ---- RTP-08 (Sep 16 audit): a durable outbox for every client message.
// Today both the manual path and the automatic sweeps write their claim BEFORE
// the provider answers, so a process killed in between loses the message with
// no way to tell a lost send from a delivered one. States: pending → attempting
// → accepted | failed | unknown. `unknown` is the honest outcome of a timeout
// after the provider may already have sent — it is never retried blindly.
model OutboxMessage {
  id            String    @id @default(cuid())
  channel       String // sms | email
  toRef         String // phone key or email address (never rendered raw to non-owners)
  clientId      String?
  projectId     String?
  taskId        String? // the SmartTask this send answers, when there is one
  body          String
  state         String    @default("pending")
  attempts      Int       @default(0)
  leaseUntil    DateTime? // a worker's claim; an expired lease is recoverable
  leaseBy       String?
  providerId    String? // the provider's own message id once accepted
  providerError String?
  dedupeKey     String?   @unique // one send per (what, whom, when) — a unique violation is a duplicate claim, nothing else
  requestedBy   String? // the person, or the sweep that queued it
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  acceptedAt    DateTime?
  resolvedAt    DateTime?

  @@index([state, createdAt])
  @@index([projectId])
  @@index([clientId])
}

// ===========================================================================
// TOPAZ VIDEO AI — one durable render job per approved cut.
//
// Jordan (Sep 16): "Once the video cut is approved, it runs through the Topaz
// Video AI API, applies a preset, and exports it at 1080p to the Dropbox
// folder… I want all videos to be ran through topaz when uploaded and approved
// in ops hub."
//
// This is a JOB, not a request. A render is minutes long, the source is 76–465
// MB (measured over the 14 cuts in the store), and a Vercel function dies at
// 300s — so every step is a state, every state is resumable, and the driver
// (/api/cron/topaz, src/lib/topazJobs.ts) picks up exactly where a dead
// invocation left off.
//
// THE MONEY RULE. Topaz auto top-up is ON with a $100/month cap Jordan set, so
// a retry loop here does not error — it BILLS HIM. Hence:
//   · submissionId is UNIQUE. One render per approved cut, enforced by
//     Postgres, not by an if-statement. Re-approving, a replayed cron and two
//     lambdas racing all collide on the same row.
//   · requestId is UNIQUE too, so a Topaz request can never be attached to two
//     jobs (the second insert loses).
//   · acceptedAt is the moment we COMMITTED to spend. Every cap (per day, per
//     month, per month in credits) counts that column, never createdAt.
//   · completeUploadAt is claimed by compare-and-swap BEFORE the call that
//     actually starts processing, so only one invocation can ever fire it.
// ===========================================================================
model TopazJob {
  id           String           @id @default(cuid())
  // ONE RENDER PER CUT, EVER. The whole spend story rests on this line.
  submission   ReviewSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionId String           @unique
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    String

  // queued → estimated → uploading → processing → saving → done
  //                    ↘ skipped (a guard refused it, nothing was spent)
  //                    ↘ failed | cancelled
  state         String    @default("queued")
  attempt       Int       @default(0) // consecutive failures of the CURRENT step
  leaseUntil    DateTime? // a driver tick's claim; an expired lease is recoverable
  leaseBy       String? // which invocation holds it (diagnostics only)
  nextAttemptAt DateTime? // backoff gate — the driver ignores the row until then

  // ---- what we are rendering (read off the file itself; the hub stores no
  // video metadata anywhere, so topaz.probeVideoMetadata reads the MP4/MOV
  // header over HTTP range requests — see the comment there)
  fileName          String?
  sourceSizeBytes   Int?
  sourceWidth       Int?
  sourceHeight      Int?
  sourceFrameRate   Float?
  sourceFrameCount  Int?
  sourceDurationSec Float?
  sourceContainer   String?
  outputWidth       Int?
  outputHeight      Int?
  /**
   * JSON: the exact filter block sent to Topaz. Kept so that when Jordan
   * compares the first render against his desktop export, the numbers that
   * produced it are on the record rather than inferred from today's settings.
   */
  presetJson        String?

  // ---- the Topaz side
  requestId           String?   @unique
  estimateCredits     Float?
  estimateSeconds     Int?
  balanceBefore       Int?
  creditsCharged      Float?
  acceptedAt          DateTime? // we committed to spend — every cap counts this
  completeUploadAt    DateTime? // CAS'd before the call that starts processing
  /**
   * How many times we have asked Topaz to START this render. complete-upload
   * is the ONE call that spends, and Topaz's own status is the only thing that
   * ever hands the claim back — so the number of times we have made it is a
   * fact worth keeping on the row rather than inferring from a shared retry
   * counter. It is a hard ceiling: at maxAttempts the job fails instead of
   * asking again (Sep 16 review — an awaiting-upload bounce that also reset
   * `attempt` could have called it every ~75 seconds, forever, with auto
   * top-up on).
   */
  completeUploadTries Int       @default(0)
  uploadUrlsJson      String? // presigned PUT targets — server-side only, never rendered
  uploadPartsJson     String? // JSON [{partNum, eTag}] — what has already landed
  uploadedBytes       Int?
  downloadUrl         String? // Topaz's finished file; Dropbox fetches it directly

  // ---- where it landed
  finalPath       String? // the enhanced file's Dropbox path (05-Final-Video)
  dropboxJobId    String? // files/save_url async job while the copy is in flight
  savedAt         DateTime?
  /**
   * When this job entered `saving`. The stall clock for the Dropbox copy has
   * to run from HERE, not from acceptedAt: a render that legitimately took
   * three hours would otherwise arrive at the filing step with half an hour of
   * patience left, and a retry would re-fail it instantly — a paid, finished
   * file that can never be filed (Sep 16 review).
   */
  savingStartedAt DateTime?

  // ---- the ping to Kyle, and his one tap back
  taskId      String? // the SmartTask telling Kyle to upload it to Aryeo
  deliveredAt DateTime?
  deliveredBy String?

  // ---- what went wrong, in words a non-technical owner can act on
  error      String?
  errorAt    DateTime?
  skipReason String?

  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([state, nextAttemptAt])
  @@index([acceptedAt])
  @@index([projectId])
  @@index([createdAt])
}

// ===== CONTENT PROGRAM OPERATING SYSTEM (Sep 16 2026) =====
//
// The ONE additive schema for the Client Content Portal spec (27 sections), so
// that every builder after this works against a fixed model and nobody touches
// migrations. Rules this block obeys, in order of what would break production:
//   · Additive only. Nothing above this line was renamed, dropped or retyped;
//     existing models gained NULLABLE/DEFAULTED columns marked "CPOS".
//   · NO @relation anywhere. Every reference is a plain String id, indexed —
//     the house style of every Content*/Portal* model, and the only style that
//     survives a db push against live data with known orphans (mis-filed calls,
//     the duplicate Rick). The diff below therefore contains no FK constraint.
//   · Every automation is a durable ROW (state + attempts + lease + lastError)
//     behind a ProgramAutomation switch whose `enabled` column DEFAULTS FALSE
//     at the database. Nothing sends, publishes or invites until Jordan flips
//     the switch — launch has not been authorised.
//   · Versioning is a table, never an overwrite: ContentStrategyVersion,
//     ContentScriptVersion, ContentTopicRefreshRun, ProgramGenerationPolicyVersion,
//     ClientAssetVersion. The current row keeps a pointer; approval records
//     who/when/which version.
//   · Clients never enter AppUser/Role. ClientUser + ClientMembership are their
//     own thing with their own cookie.
//
// NAMING CONVENTION — prefix = the layer that owns the record:
//   Client*  a client person, or something the client authored or owns
//            (ClientUser, ClientMembership, ClientEmailAlias, ClientDecision,
//            ClientFact, ClientAsset, ClientAssetVersion)
//   Content* the creative chain: strategy → pillar → topic → interview →
//            script → video → cut transcript → caption, plus imports
//   Program* the operating layer: sessions, calls, transcripts, jobs, reminders,
//            policy, owners, automation switches, publishing
//   Portal*  client-facing surfaces (PortalVisit, PortalResource)
// "Enum" columns are Strings with the allowed values in the comment — the same
// choice every Content* model already made, so values can grow without a
// migration. Money never appears on any of these tables.
// =========================================================================

// ---------------------------------------------------------------------------
// §2 IDENTITY & ACCESS (SYNTHESIS §5 Phase 1 design, reused as reviewed)
// ---------------------------------------------------------------------------

// A client PERSON who signs in by email link. Deliberately not an AppUser:
// middleware, requireRole and the PAGES map never learn about clients.
model ClientUser {
  id                  String    @id @default(cuid())
  email               String    @unique // lowercased
  name                String?
  status              String    @default("INVITED") // INVITED | ACTIVE | DISABLED
  loginTokenHash      String?   @unique // sha256 of the one-time magic-link token
  loginTokenExpiresAt DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// One person's seat on one enrollment. Re-read on EVERY request (revokedAt IS
// NULL) so revocation is immediate despite a stateless cookie. Roles decide
// who may approve edits, request changes, edit the brand profile and connect
// publishing accounts — all enforced server-side, never by hidden UI.
model ClientMembership {
  id                 String    @id @default(cuid())
  clientUserId       String // -> ClientUser
  enrollmentId       String // -> ContentEnrollment (plain ref, like every Content* model)
  clientId           String // denormalized for the ownership check
  role               String    @default("OWNER") // OWNER | COLLABORATOR | VIEWER
  invitedByAppUserId String?
  invitedAt          DateTime  @default(now())
  acceptedAt         DateTime?
  revokedAt          DateTime?
  revokedBy          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([clientUserId, enrollmentId])
  @@index([enrollmentId])
  @@index([clientId])
}

// The page-view log that does not exist today — answers "has anyone opened
// it" (0 of 11 links have any evidence of use). One row per render; the hub's
// own UsageEvent keeps excluding /portal.
model PortalVisit {
  id           String   @id @default(cuid())
  enrollmentId String
  clientUserId String? // null = token visit
  staffUserId  String? // Jordan/Kyle through the iframe
  via          String // TOKEN | LOGIN | STAFF
  path         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([enrollmentId, createdAt])
  @@index([clientUserId])
}

// Verified extra addresses a client books or writes from (spec §26: Arielle
// books from @foxroach.com, Rick from @schultzreg.com — neither is on the
// Client row). The Calendly matcher reads Client.email/backupEmail PLUS these;
// two clients on one address = ambiguous → exception queue, never a guess.
model ClientEmailAlias {
  id           String    @id @default(cuid())
  clientId     String // -> Client
  enrollmentId String? // -> ContentEnrollment
  email        String // lowercased
  source       String    @default("manual") // manual | calendly | aryeo | signup | gmail
  verifiedAt   DateTime?
  verifiedBy   String?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([clientId, email])
  @@index([email])
  @@index([enrollmentId])
}

// ---------------------------------------------------------------------------
// §3 / §21 STRATEGY — versions, source evidence, proposals
// ---------------------------------------------------------------------------

// One immutable version of a client's strategy (spec §3). The permanent brand
// FOUNDATION lives here in the source document's own hierarchy (Arielle S3,
// Bernadette S1, Rick S2 — manifest §3.3); this month's priorities live on
// ContentMonth.prioritiesJson. Approving a newer version never rewrites the
// scripts that recorded an older strategyVersionId.
model ContentStrategyVersion {
  id           String @id @default(cuid())
  strategyId   String // -> ContentStrategy (the stable identity)
  enrollmentId String
  clientId     String
  versionNo    Int

  // The document, structure preserved: sectionsJson keeps the source's own
  // numbering/hierarchy; summaryJson is the accessible summary the portal
  // shows (audience, goals, brandMessage, positioning, pillars, tone, prefs).
  structureTemplate String  @default("S3") // S1 | S2 | S3 | POLICY
  sectionsJson      String
  summaryJson       String?
  rawText           String?
  contentHash       String? // sha256 of sectionsJson — import idempotency

  // Source evidence (spec §3: brand discovery and monthly calls are separate
  // source types; store references, dates, transcripts where available).
  sourceKind       String // import | discovery_call | monthly_call | manual | ai
  sourceRef        String? // filename, Drive id, or free text
  callRecordId     String? // -> ProgramCallRecord
  importItemId     String? // -> ContentImportItem
  aiRunId          String? // -> ProgramAiRun that generated it
  policyVersionId  String? // -> ProgramGenerationPolicyVersion (the template used)
  basedOnVersionId String? // -> the version this one edits
  changeSummary    String? // what changed, in words

  status     String    @default("DRAFT") // DRAFT | INTERNAL_REVIEW | APPROVED | SUPERSEDED | REJECTED
  createdBy  String? // staff email, "ai", or "import"
  approvedBy String?
  approvedAt DateTime?
  releasedAt DateTime? // client-visible from here
  releasedBy String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([strategyId, versionNo])
  @@index([enrollmentId, status])
  @@index([clientId])
  @@index([callRecordId])
}

// A proposed change to the approved strategy or brand profile, from a call,
// a client correction, or a review (spec §3/§23: a new call must not silently
// overwrite an approved strategy; staff see the proposal, its source and its
// impact before accepting). AgentProfile is deliberately untouched: it stays
// the "My Brand Profile" READ surface; a client's correction arrives here as
// kind=PROFILE and files/values live in ClientAsset.
model ContentStrategyProposal {
  id              String    @id @default(cuid())
  enrollmentId    String
  clientId        String
  strategyId      String? // -> ContentStrategy
  baseVersionId   String? // -> ContentStrategyVersion it was proposed against
  kind            String // STRATEGY | PROFILE | PILLAR | AUDIENCE | POSITIONING | PREFERENCE
  summary         String // one line, what would change
  diffJson        String? // {path, from, to}[] against the base version
  impact          String? // what it would touch (scripts in flight, pillars, banks)
  sourceKind      String // call | client | staff | ai | import
  sourceRef       String?
  callRecordId    String? // -> ProgramCallRecord
  factId          String? // -> ClientFact that raised it
  clientUserId    String? // the client who suggested a correction
  status          String    @default("PROPOSED") // PROPOSED | ACCEPTED | REJECTED | SUPERSEDED
  resolvedBy      String?
  resolvedAt      DateTime?
  resolutionNote  String?
  resultVersionId String? // -> ContentStrategyVersion created on acceptance
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([enrollmentId, status])
  @@index([callRecordId])
  @@index([strategyId])
}

// ---------------------------------------------------------------------------
// §5 / §18 / §27 PILLARS & TOPICS
// ---------------------------------------------------------------------------

// A client's content pillar as a STABLE identity (spec §18: client-specific
// pillar names must not be replaced by a generic set; manifest C-C4: Jordan
// renames pillars at every refresh — Bernadette 4 of 5, Collins 5 of 5). The
// name here is the current one; ContentPillarAlias holds every name it has
// ever had plus the labels imports used for it.
model ContentPillar {
  id                String    @id @default(cuid())
  enrollmentId      String
  clientId          String
  strategyVersionId String? // -> ContentStrategyVersion that introduced/defined it
  name              String
  purpose           String?
  focusAreas        String?
  contentApproach   String? // optional third field (Mike's strategy)
  sortOrder         Int       @default(0)
  status            String    @default("ACTIVE") // ACTIVE | RETIRED
  retiredAt         DateTime?
  mergedIntoId      String? // -> ContentPillar, when two were folded together
  createdBy         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([enrollmentId, status])
  @@index([clientId])
  @@index([strategyVersionId])
}

// Name history + import alias table for a pillar (manifest C-A6/C-C4): a
// refresh may RENAME with Jordan's approval but never re-id; an importer
// never fails on a non-matching label — it queues a mapping here.
model ContentPillarAlias {
  id         String    @id @default(cuid())
  pillarId   String // -> ContentPillar
  name       String
  kind       String // CANONICAL | PREVIOUS | IMPORTED_LABEL | TAG
  validFrom  DateTime?
  validTo    DateTime?
  source     String? // strategy version id, import batch id, "refresh", "manual"
  approvedBy String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([pillarId, name])
  @@index([name])
}

// Append-only history of one topic (spec §5: "each topic needs … history";
// "discussed on a call" is an event, not a status). Every state change,
// selection, rejection and import writes one row with who and from what
// evidence.
model ContentTopicEvent {
  id           String   @id @default(cuid())
  topicId      String // -> ContentTopic
  enrollmentId String
  kind         String // CREATED | IMPORTED | SUGGESTED | DISCUSSED | SELECTED | DESELECTED | APPROVED | REJECTED | ARCHIVED | SCRIPTED | FILMED | DELIVERED | EDITED | RECONCILED | CARRIED | REINTRODUCED
  monthId      String? // -> ContentMonth, when the event is month-specific
  fromStatus   String?
  toStatus     String?
  actorKind    String // CLIENT | STAFF | AI | SYSTEM | IMPORT
  clientUserId String?
  staffUserId  String?
  sourceRef    String? // call record id, import item id, refresh run id, …
  evidenceJson String? // supporting excerpts {speaker, time, text}[]
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([topicId, createdAt])
  @@index([enrollmentId, createdAt])
  @@index([monthId])
}

// A topic selected FOR a named month (spec §14 "topic selections by month").
// ContentTopic.monthId stays as the legacy single pointer; this row is the
// attributable, removable, reconcilable selection — one per topic per month,
// so switching planning paths cannot duplicate it.
model ContentTopicSelection {
  id           String    @id @default(cuid())
  topicId      String // -> ContentTopic
  monthId      String // -> ContentMonth
  enrollmentId String
  clientId     String
  status       String    @default("SELECTED") // PROPOSED | SELECTED | REMOVED | RECONCILED | CARRIED
  rank         Int? // order within the month
  source       String // client | call | staff | ai | import
  clientUserId String?
  staffUserId  String?
  callRecordId String? // -> ProgramCallRecord that chose it
  evidenceJson String? // excerpts supporting "explicitly chosen"
  overflow     Boolean   @default(false) // beyond package capacity — kept, not deleted (spec §5)
  committedAt  DateTime? // staff reconciled it after the call / preparation
  removedAt    DateTime?
  removedBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([topicId, monthId])
  @@index([monthId, status])
  @@index([enrollmentId])
}

// One click of "Refresh topics" / one bank generation / one "Recommended for
// your next session" run (spec §18/§27). A JOB row: duplicate clicks collide
// on dedupeKey, a crash is recoverable through the lease, and the inputs
// used are on the record so "stale strategy inputs" can be shown.
model ContentTopicRefreshRun {
  id                 String    @id @default(cuid())
  enrollmentId       String
  clientId           String
  kind               String // BANK | REFRESH | RECOMMENDATION
  strategyVersionId  String? // -> ContentStrategyVersion used
  policyVersionId    String? // -> ProgramGenerationPolicyVersion used
  aiRunId            String? // -> ProgramAiRun
  requestedBy        String? // staff email or "system"
  monthId            String? // -> ContentMonth for a RECOMMENDATION run
  status             String    @default("QUEUED") // QUEUED | RUNNING | SUCCEEDED | FAILED | CANCELLED | NEEDS_INPUT
  attempts           Int       @default(0)
  leaseUntil         DateTime?
  leaseBy            String?
  nextAttemptAt      DateTime?
  lastError          String?
  lastErrorAt        DateTime?
  inputsJson         String? // accepted facts, goals, verified filmed history, prior suggestions considered
  missingContextJson String? // what was insufficient (never padded with generic topics)
  topicsPerPillar    Int?
  pillarCount        Int?
  generatedCount     Int       @default(0)
  changeSummary      String? // "what changed" for the UI
  dedupeKey          String?   @unique // enrollment:kind:inputsHash while active
  startedAt          DateTime?
  finishedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([enrollmentId, createdAt])
  @@index([status, nextAttemptAt])
}

// One suggestion produced by a refresh run, reviewable BEFORE it becomes a
// ContentTopic (spec §18: accept / edit / archive / regenerate each; previous
// suggestions stay accessible; archived concepts do not resurface unless
// explicitly reconsidered). Also the "Recommended for your next session"
// shortlist rows, with their actionable rationale (spec §27).
model ContentTopicSuggestion {
  id                   String    @id @default(cuid())
  refreshRunId         String // -> ContentTopicRefreshRun
  enrollmentId         String
  clientId             String
  pillarId             String? // -> ContentPillar
  kind                 String // BANK | RECOMMENDED | ALTERNATIVE
  rank                 Int?
  title                String
  description          String? // one sentence, Arielle-style
  audienceNeed         String?
  businessGoal         String?
  intendedMessage      String?
  rationale            String? // why this, in words
  whyNow               String? // recommendation only
  linkedGoal           String?
  priorContentRelation String? // NEW_ANGLE | SEQUEL | REVISIT | NONE | NO_VERIFIED_HISTORY
  relatedTopicId       String? // -> ContentTopic it follows up
  dedupeHash           String? // normalized title — blocks re-suggesting archived/rejected concepts
  reintroducedOfId     String? // -> ContentTopic explicitly reconsidered
  disposition          String    @default("PENDING") // PENDING | ACCEPTED | EDITED | ARCHIVED | REGENERATED | SUPERSEDED
  dispositionBy        String?
  dispositionAt        DateTime?
  acceptedTopicId      String? // -> ContentTopic created/linked on accept
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([refreshRunId])
  @@index([enrollmentId, disposition])
  @@index([enrollmentId, dedupeHash])
  @@index([pillarId])
  @@index([acceptedTopicId])
}

// ---------------------------------------------------------------------------
// §6 GUIDED TOPIC INTERVIEW
// ---------------------------------------------------------------------------

// The guided discussion on one topic (spec §6): resumable, one question at a
// time, four to six substantive questions. Path A (call) fills it from the
// transcript; Path B (written) from the portal — both feed the same script
// queue. One per topic per month so switching paths cannot duplicate it —
// monthId is REQUIRED because Postgres treats NULLs as distinct in a unique
// index; an interview always belongs to the month whose scripts it feeds.
model ContentInterview {
  id                      String    @id @default(cuid())
  topicId                 String // -> ContentTopic
  enrollmentId            String
  clientId                String
  monthId                 String // -> ContentMonth (required: the unique guard below depends on it)
  strategyVersionId       String? // -> ContentStrategyVersion in force
  policyVersionId         String? // -> ProgramGenerationPolicyVersion
  sourceKind              String    @default("WRITTEN") // WRITTEN | CALL | MIXED
  callRecordId            String? // -> ProgramCallRecord (Path A)
  status                  String    @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | NEEDS_FOLLOWUP | SUFFICIENT | SUBMITTED | ABANDONED
  questionPlanJson        String? // the adaptive plan {key, role, text, askedAt}[]
  currentQuestionKey      String?
  answeredCount           Int       @default(0)
  sufficiencyJson         String? // {sufficient, missing: [...]} — the specific gaps
  sufficientAt            DateTime?
  submittedAt             DateTime?
  submittedByClientUserId String?
  startedByClientUserId   String?
  staffUserId             String?
  aiRunId                 String? // -> ProgramAiRun (last question-planning run)
  lastActivityAt          DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@unique([topicId, monthId])
  @@index([enrollmentId, status])
  @@index([monthId])
  @@index([callRecordId])
}

// One answer (spec §6): edits create a NEW row that supersedes the old one,
// so regenerating can never erase what the client wrote, and every script
// version can name the exact answer rows it was built from.
model ContentInterviewAnswer {
  id                 String   @id @default(cuid())
  interviewId        String // -> ContentInterview
  questionKey        String
  questionRole       String // AUDIENCE_PROBLEM | POINT_OF_VIEW | TALKING_POINT | EVIDENCE | STORY | NEXT_STEP | FOLLOWUP
  questionText       String
  answerText         String?
  answerKind         String   @default("TYPED") // TYPED | SKIPPED | DONT_KNOW | REUSED | EXTRACTED | VOICE
  reusedFromAnswerId String? // -> ContentInterviewAnswer from an earlier interview
  sourceKind         String   @default("CLIENT") // CLIENT | CALL | STAFF
  speaker            String? // transcript speaker — a hypothetical Jordan suggested is not the client's experience
  callRecordId       String?
  transcriptSourceId String? // -> ProgramTranscriptSource
  excerptJson        String? // {time, speaker, text}[] supporting an EXTRACTED answer
  clientUserId       String?
  staffUserId        String?
  version            Int      @default(1)
  supersedesId       String? // -> ContentInterviewAnswer this edit replaced
  flagsJson          String? // {unsupported: bool, uncertain: bool, note}
  answeredAt         DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([interviewId, questionKey])
  @@index([callRecordId])
}

// ---------------------------------------------------------------------------
// §6 / §22 / §27 SCRIPT VERSIONS, APPROVAL, SHARING
// ---------------------------------------------------------------------------

// One immutable version of a script in the canonical format (Jordan's ruling:
// hook, EXACTLY three points as structured roles, close/CTA, 20–30 s target,
// no duration overrides). Records its source answers, strategy version and
// policy version; carries the delivered-work extras the canonical format has
// no slot for (manifest C-A9) so nothing Jordan uses is lost.
model ContentScriptVersion {
  id           String @id @default(cuid())
  scriptId     String // -> ContentScript (stable identity)
  enrollmentId String
  clientId     String
  versionNo    Int

  // The canonical presentation (spec §27).
  title               String
  categoryLabel       String? // "Category:" as delivered / rendered
  pillarId            String? // -> ContentPillar (the linked approved pillar)
  secondaryPillarId   String? // manifest Q12: some delivered scripts carry two
  hook                String
  pointsJson          String // [{role:"RE_HOOK"|"BUILD_UP"|"PAYOFF", text}] — exactly three, validated
  close               String
  captionCta          String? // optional caption CTA (contact ask lives here, not in the spoken close)
  body                String // full spoken script, derived from the parts above
  // Not spoken — internal/production (manifest C-A9).
  filmingNotes        String?
  creativeDirection   String?
  productionNotes     String?
  goal                String?
  alternateHooksJson  String? // string[]
  placeholdersJson    String? // ["$[PRICE]", …] that must be filled before filming
  speakerLabelsJson   String? // two-voice scripts
  sourceExcerptsJson  String? // transcript excerpts that support each line
  dimensionsCheckJson String? // Trust/Value/Credibility/Entertainment — internal reviewer text, never a score, never client-visible
  // Timing (manifest §9: 20–30 s is the target; enforcement mode open). The
  // target itself is NOT stored here — it is read through policyVersionId, so
  // no per-script column can quietly become a duration override (Jordan: none).
  spokenWordCount     Int?
  estimatedSeconds    Float?
  timingNote          String? // why this one runs long, if it does — informational, not an override
  // Deterministic validation + honest gaps (spec §27 quality gates).
  validationJson      String? // {threePoints, pillarLinked, requiredFields, duplicateOf, wordCount}
  gapsJson            String? // [{claim, why, question}] — unsupported or uncertain claims, shown not filled

  // Provenance — every generated script links to a pillar, an approved
  // strategy, a selected topic and its supporting source answers.
  source              String // AI | MANUAL | IMPORT | CLIENT_REQUEST | REGENERATE_SECTION | REVISION
  basedOnVersionId    String? // -> ContentScriptVersion
  regeneratedSections String? // JSON string[] of section keys regenerated (manual edits elsewhere preserved)
  changeSummary       String?
  interviewId         String? // -> ContentInterview
  answerIdsJson       String? // ContentInterviewAnswer ids this version was built from
  callRecordId        String? // -> ProgramCallRecord
  strategyVersionId   String? // -> ContentStrategyVersion
  policyVersionId     String? // -> ProgramGenerationPolicyVersion
  aiRunId             String? // -> ProgramAiRun
  importItemId        String? // -> ContentImportItem
  contentHash         String? // sha256 of the canonical parts — import idempotency, duplicate detection

  status     String    @default("DRAFT") // DRAFT | INTERNAL_REVIEW | APPROVED | SHARED | SUPERSEDED | REJECTED
  createdBy  String? // staff email | "ai" | "import" | client user id
  approvedBy String?
  approvedAt DateTime?
  sharedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([scriptId, versionNo])
  @@index([enrollmentId, status])
  @@index([clientId])
  @@index([interviewId])
  @@index([callRecordId])
  @@index([contentHash])
}

// The approval + share ledger (spec §22): which exact script version was
// approved, when it was released to which portal, and the delivery job that
// carried the email — so "approval succeeded, email failed" is two facts,
// and a batch approval produces ONE notification.
model ContentScriptRelease {
  id                String    @id @default(cuid())
  scriptId          String // -> ContentScript
  scriptVersionId   String // -> ContentScriptVersion (the exact saved version)
  enrollmentId      String
  clientId          String
  monthId           String? // -> ContentMonth
  action            String // APPROVE | APPROVE_AND_SHARE | SHARE | UNSHARE | UPDATE_SHARED | RETURN_TO_QUEUE
  actorAppUserId    String? // -> AppUser (Jordan)
  actorEmail        String?
  batchKey          String? // one batch approval → one email; rows share it
  releasedAt        DateTime? // portal visibility began
  notificationState String    @default("NONE") // NONE | QUEUED | SENT | FAILED | SUPPRESSED
  outboxMessageId   String? // -> OutboxMessage
  reminderId        String? // -> ProgramReminder (the SCRIPTS_READY row)
  note              String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([scriptId, createdAt])
  @@index([scriptVersionId])
  @@index([enrollmentId, createdAt])
  @@index([monthId])
  @@index([batchKey])
}

// ---------------------------------------------------------------------------
// §7 / §8 / §9 / §10 VIDEOS, CUTS, DECISIONS, TRANSCRIPTS, CAPTIONS
// ---------------------------------------------------------------------------

// ONE logical video (spec §7): the promised deliverable, grouped by the
// program month it FULFILS, with filmed/delivered dates kept separately and
// its cuts and library rows hanging off it — so a September obligation
// filmed in October neither disappears nor counts twice, and a listing video
// never consumes program allowance unless staff map it.
model ContentVideo {
  id                    String    @id @default(cuid())
  enrollmentId          String
  clientId              String
  monthId               String? // -> ContentMonth (obligation month)
  monthKey              String? // "2026-09" denormalized for grouping
  kind                  String    @default("PROGRAM") // PROGRAM | LISTING | EXTRA | CARRYOVER | OTHER
  countsTowardAllowance Boolean   @default(true)
  title                 String?
  pillarId              String? // -> ContentPillar
  format                String? // reel | talking-head | street-interview | …
  // Explicit production links (spec §9).
  topicId               String? // -> ContentTopic
  selectionId           String? // -> ContentTopicSelection
  scriptId              String? // -> ContentScript
  scriptVersionId       String? // -> ContentScriptVersion filmed
  projectId             String? // -> Project (the filming session = Aryeo appointment)
  deliverableId         String? // -> Deliverable
  slot                  Int? // slot within a multi-video deliverable
  // Cut pointers (the rows are ReviewSubmission; these are the caches).
  currentSubmissionId   String? // latest cut
  approvedSubmissionId  String? // the cut the client approved (ClientDecision is the record)
  finalSubmissionId     String? // the cut delivered as final
  finalFileRef          String? // Dropbox path / blob of the final file
  finalVersionLabel     String? // "v3 (final)"
  status                String    @default("PLANNED") // PLANNED | FILMED | EDITING | CLIENT_REVIEW | APPROVED | DELIVERED | ARCHIVED
  filmedAt              DateTime?
  deliveredAt           DateTime?
  releasedToClientAt    DateTime?
  postedByClientAt      DateTime? // "marked as posted" — NOT a verified publication
  source                String    @default("manual") // aryeo | review | import | manual | backfill
  mappedBy              String? // staff who mapped a LISTING/EXTRA into the program
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([enrollmentId, monthKey])
  @@index([monthId])
  @@index([projectId])
  @@index([topicId])
  @@index([scriptId])
  @@index([scriptVersionId])
  @@index([deliverableId])
  @@index([currentSubmissionId])
  @@index([status])
}

// One SOURCE of one logical video (a review cut round, an Aryeo listing file,
// a Dropbox final, an imported record). Unique on (kind, ref) so source
// synchronization can never create a second video for the same file.
model ContentVideoSource {
  id            String   @id @default(cuid())
  videoId       String // -> ContentVideo
  kind          String // REVIEW_CUT | ARYEO | PORTAL_VIDEO | DROPBOX | IMPORT | TOPAZ
  ref           String // submission id | aryeo:<listing>:<n> | PortalVideo.externalKey | path
  submissionId  String? // -> ReviewSubmission
  portalVideoId String? // -> PortalVideo
  round         Int?
  isFinal       Boolean  @default(false)
  label         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([kind, ref])
  @@index([videoId])
  @@index([submissionId])
}

// The client's attributable decision on ONE immutable cut (spec §8): approve
// or request changes, keyed to the submissionId they watched. A new cut needs
// its own row; an approval on an old cut can never approve its replacement.
// Duplicate submits collide on dedupeKey and create one revision job.
model ClientDecision {
  id              String   @id @default(cuid())
  submissionId    String // -> ReviewSubmission (immutable cut version)
  projectId       String // -> Project
  videoId         String? // -> ContentVideo
  enrollmentId    String
  clientId        String
  round           Int?
  contentHash     String? // ReviewSubmission.contentHash at decision time — proves what they watched
  decision        String // APPROVE | REQUEST_CHANGES
  openNotesChoice String? // INCLUDE | DISCARD | NONE — what they chose about open notes when approving
  commentIdsJson  String? // PortalComment ids bundled into this decision
  clientUserId    String? // the actual person
  staffUserId     String? // staff on their behalf (iframe)
  actorLabel      String // "Bernadette Rabel" | "Jordan (on behalf of …)" | "portal link"
  membershipRole  String? // OWNER | COLLABORATOR at the time
  revisionTaskId  String? // -> SmartTask raised for REQUEST_CHANGES
  revisionBriefId String? // -> RevisionBrief
  receiptState    String   @default("RECEIVED") // RECEIVED | ROUTED | IN_PROGRESS | DONE | SUPERSEDED
  supersededById  String? // -> ClientDecision on the replacement cut
  dedupeKey       String?  @unique // submission:decision:actor:window
  note            String?
  decidedAt       DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([submissionId])
  @@index([enrollmentId, decidedAt])
  @@index([videoId])
  @@index([projectId])
  @@index([clientUserId])
}

// A transcript generated from the ACTUAL cut, stored against that cut version
// (spec §9), with human correction kept beside the machine text. Changing
// the cut sets invalidatedAt so transcript-derived drafts lose readiness
// until checked or regenerated. A job row: state + attempts + lease.
model ContentCutTranscript {
  id             String    @id @default(cuid())
  submissionId   String // -> ReviewSubmission (the cut version)
  videoId        String? // -> ContentVideo
  projectId      String? // -> Project
  version        Int       @default(1) // a regenerate is a new row
  sourceRound    Int?
  contentHash    String? // the cut's byte hash at transcription — different cuts cannot be confused
  provider       String? // which ASR
  providerJobId  String?
  language       String?
  status         String    @default("QUEUED") // QUEUED | RUNNING | SUCCEEDED | FAILED | NEEDS_REVIEW | CANCELLED
  attempts       Int       @default(0)
  leaseUntil     DateTime?
  leaseBy        String?
  nextAttemptAt  DateTime?
  lastError      String?
  lastErrorAt    DateTime?
  text           String? // machine transcript
  segmentsJson   String? // [{start, end, text}]
  wordCount      Int?
  durationSec    Float?
  correctedText  String? // the human-corrected version, when one exists
  correctedBy    String?
  correctedAt    DateTime?
  correctionNote String?
  invalidatedAt  DateTime? // the cut changed under it
  aiRunId        String? // -> ProgramAiRun
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([submissionId, version])
  @@index([videoId])
  @@index([status, nextAttemptAt])
}

// A PROPOSED link between a historical video and a script (spec §9): AI
// matching may propose, with evidence, confidence and alternatives; staff
// confirm. Never forced, never auto-approved when uncertain; correcting a
// match keeps this row as history.
model ContentScriptMatch {
  id               String    @id @default(cuid())
  videoId          String // -> ContentVideo
  transcriptId     String? // -> ContentCutTranscript used as evidence
  scriptId         String // -> ContentScript proposed
  scriptVersionId  String? // -> ContentScriptVersion
  enrollmentId     String
  confidence       Float? // 0..1
  evidenceJson     String? // matched phrases, overlap stats
  alternativesJson String? // [{scriptId, confidence}]
  status           String    @default("PROPOSED") // PROPOSED | CONFIRMED | REJECTED | SUPERSEDED
  decidedBy        String?
  decidedAt        DateTime?
  aiRunId          String? // -> ProgramAiRun
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([videoId, status])
  @@index([scriptId])
  @@index([enrollmentId])
}

// A caption / CTA / cover-title draft for one cut (spec §10): tied to the
// cut version, the transcript, the strategy version and its author; every
// regeneration is a new row so a user's edit is never overwritten, and a
// changed cut marks the draft STALE rather than silently serving it.
model ContentCaptionDraft {
  id                String    @id @default(cuid())
  videoId           String // -> ContentVideo
  submissionId      String // -> ReviewSubmission (the chosen approved cut)
  enrollmentId      String
  clientId          String
  transcriptId      String? // -> ContentCutTranscript (primary factual source)
  scriptVersionId   String? // -> ContentScriptVersion (supporting context)
  strategyVersionId String? // -> ContentStrategyVersion
  policyVersionId   String?
  aiRunId           String?
  kind              String // CAPTION | SHORT_CAPTION | CTA | COVER_TITLE | POSTING_KIT
  body              String
  alternativesJson  String? // other options offered
  versionNo         Int       @default(1)
  basedOnId         String? // -> ContentCaptionDraft edited/regenerated from
  authorKind        String // AI | CLIENT | STAFF
  clientUserId      String?
  staffUserId       String?
  status            String    @default("DRAFT") // DRAFT | CHOSEN | ARCHIVED | STALE
  staleReason       String? // cut changed | caption regenerated after approval
  chosenAt          DateTime?
  chosenBy          String?
  contentHash       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([videoId, kind])
  @@index([submissionId])
  @@index([transcriptId])
  @@index([enrollmentId])
}

// ---------------------------------------------------------------------------
// §4 SCHEDULING — session requests as durable state
// ---------------------------------------------------------------------------

// A client's request for a content session (spec §4): "Requested, awaiting
// confirmation" until an actual Aryeo appointment exists, tied to an EXPLICIT
// program month. True self-booking is a job (state/attempts/lease) so a stale
// slot cannot produce two confirmed appointments and a provider failure
// leaves an honest, recoverable state.
model ProgramSessionRequest {
  id                      String    @id @default(cuid())
  enrollmentId            String
  clientId                String
  monthId                 String // -> ContentMonth (explicitly selected)
  kind                    String    @default("CONTENT_SESSION") // CONTENT_SESSION | EXTRA_SESSION
  slotStart               DateTime?
  slotEnd                 DateTime?
  timezone                String?
  locationText            String?
  notes                   String?
  requestedByClientUserId String?
  requestedByStaffUserId  String?
  status                  String    @default("REQUESTED") // REQUESTED | CONFIRMED | RESCHEDULE_REQUESTED | CANCEL_REQUESTED | CANCELLED | DECLINED | EXPIRED
  projectId               String? // -> Project once the Aryeo appointment exists
  aryeoAppointmentId      String?
  confirmedAt             DateTime?
  confirmedBy             String?
  cancelledAt             DateTime?
  cancelledBy             String?
  cancelReason            String?
  supersedesId            String? // -> ProgramSessionRequest this reschedule replaces
  taskId                  String? // -> SmartTask for Kyle
  capacityCheckJson       String? // sessions used/allowed, extras approved, travel capacity
  extraApprovedBy         String? // staff-approved extra beyond the package
  // Provider booking job (only when true self-booking is enabled).
  bookingState            String    @default("NONE") // NONE | QUEUED | RUNNING | SUCCEEDED | FAILED | RECONCILE
  attempts                Int       @default(0)
  leaseUntil              DateTime?
  leaseBy                 String?
  nextAttemptAt           DateTime?
  lastError               String?
  lastErrorAt             DateTime?
  dedupeKey               String?   @unique // enrollment:month:slotStart — duplicate clicks collide here
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([enrollmentId, status])
  @@index([monthId])
  @@index([projectId])
  @@index([bookingState, nextAttemptAt])
}

// ---------------------------------------------------------------------------
// §16 / §17 PROGRAM SETTINGS — owners, enrollment history, assets
// ---------------------------------------------------------------------------

// Who owns which duty (spec §16/§17, Jordan D11: Jordan owns strategy +
// script approval, Kyle owns scheduling + delivery, overridable per client
// or per month). scope DEFAULT rows are the program defaults; ENROLLMENT and
// MONTH rows override them.
model ProgramOwnerAssignment {
  id           String    @id @default(cuid())
  scope        String // DEFAULT | ENROLLMENT | MONTH
  scopeRef     String    @default("") // "" for DEFAULT, enrollment id, or month id
  duty         String // STRATEGY | SCRIPTS | SCHEDULING | DELIVERY | ESCALATION | REMINDERS
  appUserId    String? // -> AppUser
  teamMemberId String? // -> TeamMember
  label        String? // display name snapshot
  setBy        String?
  effectiveAt  DateTime  @default(now())
  endedAt      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([scope, scopeRef, duty])
  @@index([scopeRef])
}

// Every change to an enrollment's package/settings with an EFFECTIVE date and
// an explicit choice about the current month (spec §17): past-month
// quantities survive, and a hub setting never touches the payment processor —
// billingTruth says whether a value is synchronized billing or an internal
// program setting.
model ProgramEnrollmentChange {
  id                 String    @id @default(cuid())
  enrollmentId       String
  clientId           String
  field              String // package | videosPerMonth | sessionsPerMonth | sessionHours | status | callMode | noCallEligible | billingType | billingRate | billingMonths | overrides
  fromValue          String? // JSON-encoded
  toValue            String? // JSON-encoded
  effectiveAt        DateTime
  effectiveMonthKey  String? // first month the new value applies to
  currentMonthChoice String? // KEEP | APPLY — what happens to the month in flight
  reason             String?
  source             String    @default("manual") // manual | aryeo | stripe | system
  billingTruth       Boolean   @default(false) // true = mirrors the processor; false = internal setting
  changedBy          String?
  appliedAt          DateTime? // when the enrollment row actually took the value
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([enrollmentId, effectiveAt])
  @@index([clientId])
}

// A client-owned brand asset as a STABLE identity (spec §17: logo, colors,
// fonts, headshots, approved photos, example videos, pronunciation, editing
// instructions). Replacing a logo creates a new ClientAssetVersion and moves
// activeVersionId — what a delivered video used is never rewritten.
model ClientAsset {
  id              String    @id @default(cuid())
  clientId        String // -> Client
  enrollmentId    String? // -> ContentEnrollment
  type            String // LOGO | COLOR_PALETTE | BRANDING_CARD | FONT | HEADSHOT | APPROVED_PHOTO | EXAMPLE_VIDEO | PRONUNCIATION | CONTACT_CARD | EDITING_INSTRUCTIONS | PRODUCTION_PREFERENCE | OTHER
  name            String
  ownership       String    @default("CLIENT") // CLIENT | AGENCY | LICENSED
  activeVersionId String? // -> ClientAssetVersion
  status          String    @default("ACTIVE") // ACTIVE | RETIRED
  sortOrder       Int       @default(0)
  notes           String?
  retiredAt       DateTime?
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([clientId, type])
  @@index([enrollmentId])
}

// One version of an asset's file or value, with where it came from.
model ClientAssetVersion {
  id                     String   @id @default(cuid())
  assetId                String // -> ClientAsset
  versionNo              Int
  source                 String // dropbox | upload | aryeo | client_portal | manual | import
  fileRef                String? // Dropbox path or blob URL (reuses existing client storage)
  fileName               String?
  mimeType               String?
  sizeBytes              Int?
  valueText              String? // for text assets (colors, pronunciation, instructions)
  valueJson              String?
  contentHash            String?
  uploadedByClientUserId String?
  uploadedByStaffUserId  String?
  note                   String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([assetId, versionNo])
}

// ---------------------------------------------------------------------------
// §20 / §21 / §26 CALLS, TRANSCRIPTS, ONBOARDING
// ---------------------------------------------------------------------------

// A Calendly event type → hub purpose mapping (spec §26): the event-type URI
// is the machine classification key; a booking is classified ONLY when its
// URI matches an ENABLED mapping. No mapping = a configuration exception,
// never permission to ingest every similarly named call. Disabled by default.
model ProgramCalendlyEventMapping {
  id               String    @id @default(cuid())
  eventTypeUri     String    @unique
  eventName        String
  publicUrl        String?
  purpose          String // BRAND_DISCOVERY | MONTHLY_STRATEGY | IGNORED
  organizationUri  String?
  hostUri          String?
  enabled          Boolean   @default(false)
  validationStatus String    @default("UNVERIFIED") // UNVERIFIED | VALID | MISSING | RENAMED
  validatedAt      DateTime?
  lastSyncedAt     DateTime?
  lastError        String?
  createdBy        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([purpose, enabled])
}

// The internal call record (spec §20/§26): scheduled-event URI, invitee URI,
// event type, call purpose, calendar/Meet identifiers, the CONFIRMED client
// and the target onboarding record or program month. Ambiguous identity,
// type or month lands in matchState for staff, never a guess. Transcript
// sources hang off it (ProgramTranscriptSource).
model ProgramCallRecord {
  id                   String    @id @default(cuid())
  enrollmentId         String? // -> ContentEnrollment, once matched
  clientId             String? // -> Client, once matched
  clientUserId         String? // -> ClientUser (the invitee's membership) when known
  callType             String    @default("UNCLASSIFIED") // BRAND_DISCOVERY | MONTHLY_STRATEGY | UNRELATED | UNCLASSIFIED
  mappingId            String? // -> ProgramCalendlyEventMapping that classified it
  // Calendly identifiers.
  calendlyEventUri     String?   @unique
  calendlyInviteeUri   String?
  calendlyEventTypeUri String?
  inviteeEmail         String?
  inviteeName          String?
  scheduledStart       DateTime?
  scheduledEnd         DateTime?
  timezone             String?
  // Calendar / Meet linkage (calendar_event.external_id is present on all 29
  // live bookings; a Calendly id and a Meet conference id are NOT the same).
  calendarExternalId   String?
  meetLink             String?
  meetConferenceId     String?
  // Target: an onboarding record (discovery) or an explicit program month
  // (monthly) — a call held in late September may plan October.
  onboardingId         String? // -> ProgramOnboarding
  monthId              String? // -> ContentMonth
  targetMonthKey       String?
  status               String    @default("SCHEDULED") // SCHEDULED | COMPLETED | CANCELLED | RESCHEDULED | NO_SHOW
  rescheduledFromId    String? // -> ProgramCallRecord (history preserved; transcripts do not transfer unverified)
  cancelledAt          DateTime?
  matchState           String    @default("PENDING") // PENDING | MATCHED | UNMATCHED_INVITEE | AMBIGUOUS_CLIENT | AMBIGUOUS_MONTH | UNMAPPED_TYPE | CONFIRMED_BY_STAFF | IGNORED
  matchNote            String?
  confirmedBy          String?
  confirmedAt          DateTime?
  transcriptState      String    @default("NONE") // NONE | AWAITING | CANDIDATES | CONFIRMED | ANALYZED | FAILED | NEEDS_REVIEW
  analysisRunId        String? // -> ProgramAiRun (latest analysis)
  analysisJson         String? // the six §20 outputs, each with excerpt refs
  lastError            String?
  lastErrorAt          DateTime?
  rawJson              String? // provider payload snapshot
  legacyMonthId        String? // -> ContentMonth whose calendlyEventUri/transcript fields this row was lifted from
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([enrollmentId, scheduledStart])
  @@index([clientId])
  @@index([monthId])
  @@index([matchState])
  @@index([transcriptState])
  @@index([inviteeEmail])
  @@index([calendarExternalId])
  @@index([mappingId])
  @@index([onboardingId])
}

// One transcript SOURCE (a Drive/Gemini doc, a Meet transcript, a paste, an
// upload). Deduplicated across providers by content hash; a corrected
// transcript is a new version that supersedes the old; an unlinked one sits
// as a CANDIDATE for staff confirmation with title, time and participants —
// similar names and times rank candidates but never establish ownership.
model ProgramTranscriptSource {
  id                   String    @id @default(cuid())
  callRecordId         String? // -> ProgramCallRecord once confirmed
  provider             String // drive | meet | notetaker | paste | upload | pdf
  externalId           String? // Drive file id, Meet transcript name, …
  sourceUrl            String?
  title                String?
  recordedAt           DateTime?
  participantsJson     String?
  text                 String?
  contentHash          String    @unique
  version              Int       @default(1)
  supersedesId         String? // -> ProgramTranscriptSource (corrected transcript)
  matchState           String    @default("UNMATCHED") // UNMATCHED | CANDIDATE | CONFIRMED | REJECTED | IGNORED
  candidateCallIdsJson String? // ranked ProgramCallRecord ids with scores
  confirmedBy          String?
  confirmedAt          DateTime?
  readinessState       String? // Meet: FILE_GENERATED etc. — ingest after readiness, not at meeting end
  legacyMonthId        String? // -> ContentMonth.transcriptSource this was lifted from
  createdBy            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([callRecordId])
  @@index([provider, externalId])
  @@index([matchState])
}

// One unit of transcript work (spec §20): ingest, analyze, draft a strategy,
// draft scripts — with separate queued/running/succeeded/failed/needs-review
// states and a lease, so marking a transcript processed before work succeeds
// can never suppress future retries, and a rerun cannot duplicate output
// (dedupeKey).
model ProgramTranscriptJob {
  id                 String    @id @default(cuid())
  callRecordId       String // -> ProgramCallRecord
  transcriptSourceId String? // -> ProgramTranscriptSource
  enrollmentId       String?
  kind               String // INGEST | ANALYZE | STRATEGY_DRAFT | SCRIPT_DRAFT | FACT_EXTRACT
  state              String    @default("QUEUED") // QUEUED | RUNNING | SUCCEEDED | FAILED | NEEDS_REVIEW | CANCELLED
  attempts           Int       @default(0)
  maxAttempts        Int       @default(3)
  leaseUntil         DateTime?
  leaseBy            String?
  nextAttemptAt      DateTime?
  startedAt          DateTime?
  finishedAt         DateTime?
  lastError          String?
  lastErrorAt        DateTime?
  reviewReason       String? // why a human must look
  resultJson         String? // ids of what was produced (topics, answers, scripts, facts, proposals)
  aiRunId            String? // -> ProgramAiRun
  // Key format per kind: INGEST is per SOURCE ("<callRecordId>:<transcriptSourceId>:INGEST")
  // because each Drive/Meet copy must be pulled once; every other kind is per
  // CALL ("<callRecordId>:<kind>") so a Drive copy and a Meet copy of the same
  // meeting — different contentHash, same call — yield ONE analysis, ONE
  // strategy draft, ONE script draft, ONE fact extraction (spec §20).
  dedupeKey          String?   @unique
  requestedBy        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([state, nextAttemptAt])
  @@index([callRecordId])
  @@index([transcriptSourceId])
}

// The onboarding record (spec §21): program, brand-discovery requirement,
// booking, source call, intake answers, asset completeness, generated
// strategy draft and its approval — one per enrollment. Discovery stays a
// separate requirement unless staff explicitly waive it.
model ProgramOnboarding {
  id                        String    @id @default(cuid())
  enrollmentId              String    @unique
  clientId                  String
  status                    String    @default("NOT_STARTED") // NOT_STARTED | DISCOVERY_BOOKED | DISCOVERY_HELD | TRANSCRIPT_PENDING | STRATEGY_DRAFTED | STRATEGY_IN_REVIEW | STRATEGY_APPROVED | BANK_GENERATED | COMPLETE | WAIVED
  discoveryRequired         Boolean   @default(true)
  discoveryWaivedAt         DateTime?
  discoveryWaivedBy         String?
  discoveryWaivedReason     String?
  discoveryCallRecordId     String? // -> ProgramCallRecord
  intakeJson                String? // the 41-question instrument (manifest §3.6), answers + pre-filled marks
  intakeSubmittedAt         DateTime?
  intakeSource              String? // portal | staff | import
  brandInputsJson           String? // source-backed draft profile facts
  assetChecklistJson        String? // which asset types exist / are missing
  missingItemsJson          String? // unanswered questions + missing assets, explicit
  strategyDraftVersionId    String? // -> ContentStrategyVersion (DRAFT)
  strategyGenerationRunId   String? // -> ProgramAiRun
  strategyApprovedVersionId String? // -> ContentStrategyVersion (APPROVED)
  initialBankRunId          String? // -> ContentTopicRefreshRun
  lastError                 String?
  lastErrorAt               DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([clientId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// §23 STRUCTURED CLIENT KNOWLEDGE (replaces ContentNote.intelligence)
// ---------------------------------------------------------------------------

// One fact about a client with source, date, scope, status, visibility, AI
// permission and supersession (spec §23). Generators read ACCEPTED facts
// whose aiContext is ALLOWED — never an unreviewed pile. "Let's try faster
// cuts on this one" is scope PROJECT and cannot change every future video.
// Confidentiality is a structured column here, not a text marker.
model ClientFact {
  id                 String    @id @default(cuid())
  clientId           String
  enrollmentId       String?
  category           String // BRAND_PREFERENCE | PRODUCTION_PREFERENCE | PERFORMANCE_REPORTED | PERFORMANCE_MEASURED | DECISION | COMMITMENT | INTERNAL | PROPOSED_CHANGE | FEEDBACK
  fieldKey           String? // approved field policy key, e.g. "editing.pace", "brand.voice" — routine updates auto-accept per field rules
  body               String
  source             String // call | import | client | staff | ai | note_migration | review | comms
  sourceRef          String? // free pointer (CommLog id, note id, file)
  callRecordId       String? // -> ProgramCallRecord
  transcriptSourceId String? // -> ProgramTranscriptSource
  excerptJson        String? // {time, speaker, text}[] — speaker attribution matters
  speaker            String?
  factDate           DateTime? // when it was said / became true
  scope              String    @default("PERMANENT") // PERMANENT | MONTH | PROJECT
  monthId            String? // -> ContentMonth for MONTH scope
  projectId          String? // -> Project for PROJECT scope
  status             String    @default("PROPOSED") // PROPOSED | ACCEPTED | REJECTED | SUPERSEDED | UNDONE
  supersedesId       String? // -> ClientFact this replaces
  supersededById     String? // -> ClientFact that replaced it
  visibility         String    @default("INTERNAL") // INTERNAL | CLIENT
  aiContext          String    @default("DENIED") // ALLOWED | DENIED — denied until reviewed
  confidential       Boolean   @default(false)
  confidence         Float? // 0..1, advisory only — never overrides a conflicting explicit instruction
  conflictsWithId    String? // -> ClientFact — an exception to resolve, not an overwrite
  autoAccepted       Boolean   @default(false)
  reviewedBy         String?
  reviewedAt         DateTime?
  undoneBy           String?
  undoneAt           DateTime?
  legacyNoteId       String?   @unique // -> ContentNote it was migrated from
  aiRunId            String? // -> ProgramAiRun that extracted it
  dedupeHash         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([clientId, status])
  @@index([clientId, category])
  @@index([enrollmentId])
  @@index([monthId])
  @@index([projectId])
  @@index([callRecordId])
  @@index([clientId, dedupeHash])
}

// ---------------------------------------------------------------------------
// §13 AI RUNS & QUOTAS
// ---------------------------------------------------------------------------

// Every AI invocation, on the record (spec §13): client scope, input refs,
// prompt/model version, output ref, status, cost and the human disposition.
// aiJson() discards usage today and unattended cron spend is unbounded —
// this row is what quotas count and what "observable failure" means.
model ProgramAiRun {
  id                String    @id @default(cuid())
  kind              String // call_analysis | fact_extract | strategy_draft | topic_bank | topic_refresh | recommendation | interview_plan | script_draft | script_revise | creative_review | caption | transcript | script_match | profile_draft
  enrollmentId      String?
  clientId          String?
  scopeJson         String? // {monthId, topicId, scriptId, submissionId, callRecordId, …}
  inputRefsJson     String? // record ids and hashes the prompt was built from
  promptKey         String
  promptVersion     String?
  model             String?
  policyVersionId   String? // -> ProgramGenerationPolicyVersion
  strategyVersionId String? // -> ContentStrategyVersion
  status            String    @default("QUEUED") // QUEUED | RUNNING | SUCCEEDED | FAILED | CANCELLED | QUOTA_BLOCKED
  attempts          Int       @default(0)
  leaseUntil        DateTime?
  leaseBy           String?
  nextAttemptAt     DateTime?
  inputTokens       Int?
  outputTokens      Int?
  costCents         Int?
  outputRef         String? // "ContentScriptVersion:<id>" etc.
  outputJson        String? // raw structured output, for audit
  disposition       String    @default("PENDING") // PENDING | ACCEPTED | EDITED | REJECTED | SUPERSEDED | NOT_APPLICABLE
  dispositionBy     String?
  dispositionAt     DateTime?
  requestedBy       String? // staff email | "cron" | client user id
  dedupeKey         String?   @unique
  error             String?
  errorAt           DateTime?
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([enrollmentId, createdAt])
  @@index([kind, createdAt])
  @@index([status, nextAttemptAt])
}

// A spend/run ceiling (spec §13): global, per enrollment or per run kind, per
// day or month. Counted against ProgramAiRun.startedAt. A missing row means
// the code default applies, which is conservative.
model ProgramAiQuota {
  id           String   @id @default(cuid())
  scope        String // GLOBAL | ENROLLMENT | KIND
  scopeRef     String   @default("") // "" | enrollment id | run kind
  period       String // DAY | MONTH
  maxRuns      Int?
  maxCostCents Int?
  enabled      Boolean  @default(true)
  setBy        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([scope, scopeRef, period])
}

// ---------------------------------------------------------------------------
// §14 IMPORTS — preserve the source, preview, idempotent
// ---------------------------------------------------------------------------

// One import of one source file (spec §14): its hash is the idempotency key,
// so re-uploading Marcee's July scripts re-opens this batch instead of
// inserting every script again. Applied only after a preview; nothing it
// creates is approved, filmed or released by virtue of a past document date.
model ContentImportBatch {
  id               String    @id @default(cuid())
  kind             String // SCRIPTS | TOPICS | STRATEGY | TRANSCRIPT | VIDEOS | INTAKE
  enrollmentId     String?
  clientId         String?
  fileName         String?
  contentHash      String // sha256 of the source bytes
  sourceRef        String? // Drive id / blob path / Downloads path
  sourceMtime      DateTime?
  proposedMonthKey String? // the document's month; Jordan confirms per client (D10)
  mode             String    @default("PREVIEW") // PREVIEW | APPLIED | ABANDONED
  previewJson      String? // counts + per-item modes for the confirmation screen
  uploadedBy       String?
  appliedAt        DateTime?
  appliedBy        String?
  itemsCreated     Int       @default(0)
  itemsLinked      Int       @default(0)
  itemsUpdated     Int       @default(0)
  itemsConflict    Int       @default(0)
  itemsSkipped     Int       @default(0)
  lastError        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([kind, contentHash])
  @@index([enrollmentId])
  @@index([clientId])
}

// One parsed item inside a batch with its proposed and decided mode
// (create / link / update-proposal / conflict / skip), the original source
// text kept whole, and the record it produced or linked to.
model ContentImportItem {
  id               String    @id @default(cuid())
  batchId          String // -> ContentImportBatch
  ordinal          Int
  kind             String // SCRIPT | TOPIC | PILLAR | STRATEGY_SECTION | VIDEO | INTAKE_ANSWER | TRANSCRIPT
  sourceHash       String // sha256 of the normalized source text
  sourceText       String // verbatim
  parsedJson       String? // the structured parse (title, category label, hook, points, close, caption, marks)
  proposedMode     String // CREATE | LINK | UPDATE_PROPOSAL | CONFLICT | SKIP
  decidedMode      String?
  decidedBy        String?
  decidedAt        DateTime?
  targetKind       String? // ContentScript | ContentTopic | ContentPillar | ContentStrategy | ContentVideo
  targetId         String? // existing record it links to / conflicts with
  resultId         String? // record created on apply
  proposedMonthKey String?
  importedMark     String? // colour/bold mark from the source (manifest §5.3)
  proposedState    String? // what the mark suggests, awaiting confirmation
  pillarLabel      String? // the label as written; mapped through ContentPillarAlias
  conflictNote     String?
  error            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([batchId, sourceHash])
  @@index([batchId, ordinal])
  @@index([sourceHash])
  @@index([targetId])
  @@index([resultId])
}

// ---------------------------------------------------------------------------
// §24 REMINDERS
// ---------------------------------------------------------------------------

// The reminder ledger (spec §24): client / month / action / template, the
// attempt, the outbox row and provider id, the outcome, when it is next
// eligible and why it was suppressed. The evaluator rechecks authoritative
// state right before sending and records what it saw. Duplicate runs collide
// on dedupeKey; two evaluators cannot work the same row (lease). Nothing here
// sends unless ProgramAutomation "reminders" is on.
model ProgramReminder {
  id                   String    @id @default(cuid())
  enrollmentId         String
  clientId             String
  monthId              String? // -> ContentMonth
  monthKey             String?
  action               String // CHOOSE_PATH | BOOK_CALL | COMPLETE_ANSWERS | BOOK_SESSION | REVIEW_WORK | DIGEST | SCRIPTS_READY | SESSION_REQUEST_FOLLOWUP | ESCALATION
  templateKey          String
  templateVersion      String?
  channel              String    @default("email") // email | sms
  toRef                String? // address or phone key — never rendered raw to non-owners
  attempt              Int       @default(1)
  state                String    @default("PENDING") // PENDING | SUPPRESSED | QUEUED | SENT | FAILED | BOUNCED | UNKNOWN | CANCELLED
  outboxMessageId      String? // -> OutboxMessage
  providerMessageId    String?
  outcome              String? // accepted | bounced | failed | unknown
  evaluatedStateJson   String? // what the recheck saw (booked? path chosen? paused? snoozed?)
  suppressionReason    String? // booked | no_call_chosen | preparation_submitted | paused | snoozed | quiet_hours | duplicate | pending_session_request | stale_sync
  nextEligibleAt       DateTime? // business-time eligibility (quiet hours, deadline arithmetic)
  // Job lease (R6): the evaluator claims a row before the recheck + enqueue.
  leaseUntil           DateTime?
  leaseBy              String?
  nextAttemptAt        DateTime? // retry clock after a FAILED enqueue/send
  sentAt               DateTime?
  failedAt             DateTime?
  lastError            String?
  lastErrorAt          DateTime?
  manual               Boolean   @default(false) // send-now / copy-link by staff — same safeguards, same history
  requestedBy          String?
  escalatedToAppUserId String?
  escalationTaskId     String? // -> SmartTask
  dedupeKey            String?   @unique // enrollment:monthKey:action:attempt
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([enrollmentId, createdAt])
  @@index([monthId, action])
  @@index([state, nextEligibleAt])
  @@index([state, nextAttemptAt])
}

// ---------------------------------------------------------------------------
// §27 GENERATION POLICY (versioned)
// ---------------------------------------------------------------------------

// ONE versioned generation policy (spec §27): the strategy template, the
// reference manifest, topics per pillar, timing target, script format,
// creative rules and quality rubric. Its id is stamped on every generated
// bank, strategy draft and script version. Jordan's rulings are the
// defaults: exactly three points, 20–30 s, 10 per pillar (configurable to 15).
model ProgramGenerationPolicyVersion {
  id                    String    @id @default(cuid())
  versionNo             Int       @unique
  name                  String
  status                String    @default("DRAFT") // DRAFT | ACTIVE | RETIRED — one ACTIVE, enforced in code
  strategyTemplateJson  String // Arielle S3 hierarchy: sections, subsections, optional fields
  referenceManifestRef  String? // path/hash of the manifest this version was built from
  referenceManifestJson String? // the rules table, tagged by source
  topicsPerPillar       Int       @default(10)
  topicsPerPillarMax    Int       @default(15)
  recommendedPerSession Int? // shortlist size = session/month capacity; null = derive from the enrollment
  talkingPoints         Int       @default(3)
  pointRolesJson        String    @default("[\"RE_HOOK\",\"BUILD_UP\",\"PAYOFF\"]")
  timingTargetMinSec    Int       @default(20)
  timingTargetMaxSec    Int       @default(30)
  wordRangeJson         String? // {min:45, max:65} — a drafting heuristic, not proof of duration
  scriptFormatJson      String? // label strings, ordering, caption CTA rule
  creativeRulesJson     String? // hook standards, bans, devices, voice rules (tagged by source)
  rubricJson            String? // Trust/Value/Credibility/Entertainment definitions + editorial checks
  validatorsJson        String? // deterministic checks: required fields, three points, pillar linkage, counts, duplication
  promptsJson           String? // {promptKey: promptVersion} — one policy, no drifting prompts per entry point
  notes                 String?
  createdBy             String?
  activatedAt           DateTime?
  activatedBy           String?
  retiredAt             DateTime?
  contentHash           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([status])
}

// ---------------------------------------------------------------------------
// R6 AUTOMATION SWITCHES — every automation is OFF at the database
// ---------------------------------------------------------------------------

// One row per automation the spec names. `enabled` defaults FALSE in
// Postgres, not in code: reminders, transcript jobs, AI runs, publishing,
// script-ready emails, portal invites, topic refresh, strategy generation,
// session self-booking. Nothing runs, sends or invites until Jordan flips a
// row — launch has not been authorised. The push creates NO rows (no seed is
// allowed), so every job driver MUST treat a MISSING row as DISABLED — the
// only reading under which "OFF at the database" is true on day one. The
// reminder POLICY (deadlines, lead times, cadence, timezone, business hours,
// sender, escalation owner) lives in configJson of the "reminders" row; see
// DESIGN.md for the shape.
model ProgramAutomation {
  id          String    @id @default(cuid())
  key         String    @unique // reminders | transcript_jobs | ai_runs | publishing | script_share_email | portal_invites | portal_login_email | topic_refresh | strategy_generation | session_booking | cut_transcripts | caption_assistant | fact_extraction
  enabled     Boolean   @default(false)
  enabledBy   String?
  enabledAt   DateTime?
  disabledBy  String?
  disabledAt  DateTime?
  configJson  String? // the automation's settings shape (documented in DESIGN.md)
  lastRunAt   DateTime?
  lastError   String?
  lastErrorAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// §12 PUBLISHING (separate phase; disabled)
// ---------------------------------------------------------------------------

// A connected publishing account (spec §12): clear identity, encrypted
// credentials, connect/disconnect/revoke history. Disconnecting or revoking
// consent must stop every queued job on it.
model ProgramPublishingAccount {
  id                      String    @id @default(cuid())
  enrollmentId            String
  clientId                String
  provider                String // INSTAGRAM | FACEBOOK | TIKTOK | YOUTUBE
  providerAccountId       String
  handle                  String?
  displayName             String?
  accountType             String? // business | creator | personal
  credentialEncrypted     String? // encrypted-at-rest token blob (lib/integrations/crypto.ts)
  scopesJson              String?
  tokenExpiresAt          DateTime?
  timezone                String?
  status                  String    @default("CONNECTED") // CONNECTED | DISCONNECTED | REVOKED | EXPIRED | ERROR
  connectedAt             DateTime  @default(now())
  connectedByClientUserId String?
  connectedByStaffUserId  String?
  disconnectedAt          DateTime?
  disconnectedBy          String?
  revokedAt               DateTime?
  lastValidatedAt         DateTime?
  lastError               String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@unique([provider, providerAccountId])
  @@index([enrollmentId, status])
}

// One publication attempt of one approved cut with one caption (spec §12):
// explicit publication approval, chosen timezone, job state with retries
// that cannot double-post (dedupeKey + provider ids), and success ONLY on
// confirmed provider receipt. A new cut or caption after approval
// invalidates the job and requires a renewed decision.
model ProgramPublishingJob {
  id                     String    @id @default(cuid())
  accountId              String // -> ProgramPublishingAccount
  enrollmentId           String
  clientId               String
  videoId                String // -> ContentVideo
  submissionId           String // -> ReviewSubmission (the exact approved cut)
  captionDraftId         String? // -> ContentCaptionDraft
  captionText            String // snapshot at approval
  coverRef               String?
  mediaValidationJson    String? // supported-media checks
  scheduledFor           DateTime?
  timezone               String?
  approvedByClientUserId String?
  approvedByStaffUserId  String?
  approvedAt             DateTime?
  state                  String    @default("DRAFT") // DRAFT | APPROVED | QUEUED | RUNNING | AWAITING_PROVIDER | SUCCEEDED | FAILED | CANCELLED | RECONCILE | INVALIDATED
  attempts               Int       @default(0)
  leaseUntil             DateTime?
  leaseBy                String?
  nextAttemptAt          DateTime?
  providerContainerId    String? // e.g. Instagram media container id
  providerMediaId        String? // confirmed platform receipt
  providerPermalink      String?
  providerResponseJson   String?
  lastError              String?
  lastErrorAt            DateTime?
  invalidatedAt          DateTime?
  invalidatedReason      String? // new cut | caption changed | account disconnected | consent revoked
  dedupeKey              String?   @unique // account:submission:captionHash
  startedAt              DateTime?
  finishedAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([accountId, state])
  @@index([videoId])
  @@index([submissionId])
  @@index([state, nextAttemptAt])
}

// ---------------------------------------------------------------------------
// §11 CLIENT-FACING RESOURCES
// ---------------------------------------------------------------------------

// A client-facing guide (spec §11): grouped, owned, last-reviewed, with
// platform/device context, editable by staff without a deploy. Separate from
// `Resource` (Kyle's staff link list, whose `url` is required — a guide is a
// body, not a link) and from `Sop`. Unpublished by default.
model PortalResource {
  id             String    @id @default(cuid())
  slug           String    @unique
  groupKey       String // PREPARING_SESSION | REVIEWING_VIDEOS | POSTING_CONTENT | IMPROVING_RESULTS
  title          String
  summary        String?
  body           String // markdown
  platform       String? // instagram | facebook | tiktok | youtube | general
  deviceContext  String? // ios | android | desktop | any
  ownerAppUserId String? // -> AppUser responsible for keeping it current
  reviewedAt     DateTime?
  reviewedBy     String?
  linkedActions  String? // JSON string[] of task/action keys this guide is linked from
  published      Boolean   @default(false)
  sortOrder      Int       @default(0)
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([groupKey, published, sortOrder])
}
